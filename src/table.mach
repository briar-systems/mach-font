# the sfnt offset table and table directory
#
# a truetype file opens with an offset table naming a table count, followed by
# that many 16-byte directory entries. each entry carries a four-byte tag and the
# byte offset and length of one table within the file. this module validates that
# header and resolves a table span by tag. every read is bounds-checked through
# font.read, so a truncated or malformed directory reports failure rather than
# reading out of bounds.

use font.error.FontError;
use font.read;
use std.types.bool.bool;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

# byte offset of the table directory, immediately after the 12-byte offset table
val DIR_OFFSET: usize = 12;
# size in bytes of one table directory entry
val ENTRY_SIZE: usize = 16;

# sfnt version tagging a file that carries truetype (glyf) outlines
val SFNT_TRUETYPE: u32 = 0x00010000;
# legacy 'true' sfnt version, also truetype outlines
val SFNT_TRUE: u32 = 0x74727565;

# the located byte span of one table within the font file
# ---
# offset: byte offset of the table's first byte from the start of the file
# length: table length in bytes
pub rec Table {
    offset: u32;
    length: u32;
}

# check that the file begins with a truetype-outline sfnt version
#
# rejects 'OTTO' (CFF outlines) and 'ttcf' (font collections), which carry no
# glyf table and are out of scope.
# ---
# data: pointer to the first byte of the file
# len:  number of bytes addressable through data
# ret:  ok for truetype outlines, not_truetype with the version read, or truncated
pub fun check_truetype(data: *u8, len: usize) err[FontError] {
    val v: res[u32, FontError] = read.read_u32(data, len, 0);
    if (sel v.err) { ret err[FontError].err{v.err}; }
    if (v.ok != SFNT_TRUETYPE && v.ok != SFNT_TRUE) {
        ret err[FontError].err{FontError.not_truetype{v.ok}};
    }
    ret err[FontError].ok{};
}

# read the number of tables declared by the offset table
# ---
# data: pointer to the first byte of the file
# len:  number of bytes addressable through data
# ret:  the table count, or truncated
pub fun num_tables(data: *u8, len: usize) res[u16, FontError] {
    ret read.read_u16(data, len, 4);
}

# locate a table by its four-byte tag
#
# scans the directory for an entry whose tag matches, then reads that entry's
# offset and length. the returned span is not itself range-checked against the
# file, since callers validate spans as they read table contents through
# font.read. a font without the table is not a failure, only a directory that
# runs past the file is.
# ---
# data: pointer to the first byte of the file
# len:  number of bytes addressable through data
# a, b, c, d: the four tag bytes to match (e.g. 'g','l','y','f')
# ret: the table span, none when the directory lists no such table, or truncated
pub fun find_table(data: *u8, len: usize, a: u8, b: u8, c: u8, d: u8) res[opt[Table], FontError] {
    val count: res[u16, FontError] = num_tables(data, len);
    if (sel count.err) { ret res[opt[Table], FontError].err{count.err}; }

    var i: usize = 0;
    for (i < count.ok::usize) {
        val entry: usize                = DIR_OFFSET + i * ENTRY_SIZE;
        val same:  res[bool, FontError] = read.tag_eq(data, len, entry, a, b, c, d);
        if (sel same.err) { ret res[opt[Table], FontError].err{same.err}; }
        if (same.ok) {
            val off: res[u32, FontError] = read.read_u32(data, len, entry + 8);
            if (sel off.err) { ret res[opt[Table], FontError].err{off.err}; }
            val length: res[u32, FontError] = read.read_u32(data, len, entry + 12);
            if (sel length.err) { ret res[opt[Table], FontError].err{length.err}; }
            ret res[opt[Table], FontError].ok{opt[Table].some{Table{offset: off.ok, length: length.ok}}};
        }
        i = i + 1;
    }

    ret res[opt[Table], FontError].ok{opt[Table].none{}};
}

# write a big-endian u16 into a test fixture buffer
fun put_u16(buf: *u8, off: usize, v: u16) {
    buf[off]     = (v >> 8)::u8;
    buf[off + 1] = (v & 0xFF)::u8;
}

# write a big-endian u32 into a test fixture buffer
fun put_u32(buf: *u8, off: usize, v: u32) {
    buf[off]     = (v >> 24)::u8;
    buf[off + 1] = ((v >> 16) & 0xFF)::u8;
    buf[off + 2] = ((v >> 8) & 0xFF)::u8;
    buf[off + 3] = (v & 0xFF)::u8;
}

# write a four-byte tag into a test fixture buffer
fun put_tag(buf: *u8, off: usize, a: u8, b: u8, c: u8, d: u8) {
    buf[off]     = a;
    buf[off + 1] = b;
    buf[off + 2] = c;
    buf[off + 3] = d;
}

var dir_buf: [44]u8;

# build a two-entry offset table + directory: cmap at 100/16, glyf at 200/48
fun build_dir() {
    put_u32(?dir_buf[0], 0, SFNT_TRUETYPE);
    put_u16(?dir_buf[0], 4, 2);
    put_u16(?dir_buf[0], 6, 0);
    put_u16(?dir_buf[0], 8, 0);
    put_u16(?dir_buf[0], 10, 0);

    put_tag(?dir_buf[0], 12, 'c', 'm', 'a', 'p');
    put_u32(?dir_buf[0], 16, 0);
    put_u32(?dir_buf[0], 20, 100);
    put_u32(?dir_buf[0], 24, 16);

    put_tag(?dir_buf[0], 28, 'g', 'l', 'y', 'f');
    put_u32(?dir_buf[0], 32, 0);
    put_u32(?dir_buf[0], 36, 200);
    put_u32(?dir_buf[0], 40, 48);
}

test "table: truetype sfnt version accepted" {
    build_dir();
    val r: err[FontError] = check_truetype(?dir_buf[0], 44);
    if (!sel r.ok) { ret 1; }
    ret 0;
}

test "table: OTTO rejected" {
    build_dir();
    put_u32(?dir_buf[0], 0, 0x4F54544F);
    val r: err[FontError] = check_truetype(?dir_buf[0], 44);
    if (!sel r.err)                       { ret 1; }
    if (!sel r.err.not_truetype)          { ret 2; }
    if (r.err.not_truetype != 0x4F54544F) { ret 3; }
    ret 0;
}

test "table: num_tables" {
    build_dir();
    val n: res[u16, FontError] = num_tables(?dir_buf[0], 44);
    if (!sel n.ok) { ret 1; }
    if (n.ok != 2) { ret 2; }
    ret 0;
}

# unwrap a located table, reporting a missing or failed lookup as a zero span
fun found(r: res[opt[Table], FontError]) Table {
    if (sel r.err)     { ret Table{offset: 0, length: 0}; }
    if (sel r.ok.none) { ret Table{offset: 0, length: 0}; }
    ret r.ok.some;
}

test "table: find present entries" {
    build_dir();
    val glyf: Table = found(find_table(?dir_buf[0], 44, 'g', 'l', 'y', 'f'));
    if (glyf.offset != 200 || glyf.length != 48) { ret 1; }
    val cmap: Table = found(find_table(?dir_buf[0], 44, 'c', 'm', 'a', 'p'));
    if (cmap.offset != 100 || cmap.length != 16) { ret 2; }
    ret 0;
}

test "table: missing tag" {
    build_dir();
    val r: res[opt[Table], FontError] = find_table(?dir_buf[0], 44, 'h', 'e', 'a', 'd');
    if (!sel r.ok)      { ret 1; }
    if (!sel r.ok.none) { ret 2; }
    ret 0;
}

test "table: truncated directory rejected" {
    build_dir();
    # only the offset table plus one full entry fit, so the second entry's span runs past len.
    val r: res[opt[Table], FontError] = find_table(?dir_buf[0], 28, 'g', 'l', 'y', 'f');
    if (!sel r.err)            { ret 1; }
    if (!sel r.err.truncated)  { ret 2; }
    if (r.err.truncated != 28) { ret 3; }
    ret 0;
}
