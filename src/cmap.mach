# character-to-glyph mapping
#
# the cmap table holds one or more encoding subtables, each mapping character
# codes to glyph indices under some platform encoding. this module selects a
# unicode subtable and resolves a codepoint through it. format 4 (segmented BMP
# coverage) is the near-universal encoding for the basic multilingual plane;
# format 12 (segmented full coverage) extends past U+FFFF. an unmapped codepoint
# resolves to glyph 0 (.notdef), the truetype convention for a missing glyph,
# and only a malformed or truncated subtable reports failure. all reads are
# bounds-checked through font.read.

use font.error.FontError;
use font.read;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.result.res;
use std.types.size.usize;

# select a unicode cmap subtable and return its absolute byte offset
#
# scans the encoding records and prefers full-repertoire unicode (format 12
# candidates) over basic-multilingual-plane unicode, and either over a symbol
# encoding. the returned offset is absolute (cmap table offset plus the record's
# relative subtable offset).
# ---
# data:     pointer to the first byte of the file
# len:      number of bytes addressable through data
# cmap_off: byte offset of the cmap table
# ret:      the selected subtable's absolute byte offset, or no_unicode_cmap or truncated
pub fun select_subtable(data: *u8, len: usize, cmap_off: usize) res[usize, FontError] {
    val count: res[u16, FontError] = read.read_u16(data, len, cmap_off + 2);
    if (sel count.err) { ret res[usize, FontError].err{count.err}; }

    var best_score: i32   = 0;
    var best_off:   usize = 0;

    var i: usize = 0;
    for (i < count.ok::usize) {
        val rec:      usize               = cmap_off + 4 + i * 8;
        val platform: res[u16, FontError] = read.read_u16(data, len, rec);
        if (sel platform.err) { ret res[usize, FontError].err{platform.err}; }
        val encoding: res[u16, FontError] = read.read_u16(data, len, rec + 2);
        if (sel encoding.err) { ret res[usize, FontError].err{encoding.err}; }
        val sub_rel: res[u32, FontError] = read.read_u32(data, len, rec + 4);
        if (sel sub_rel.err) { ret res[usize, FontError].err{sub_rel.err}; }

        val score: i32 = encoding_score(platform.ok, encoding.ok);
        if (score > best_score) {
            best_score = score;
            best_off   = cmap_off + sub_rel.ok::usize;
        }
        i = i + 1;
    }

    if (best_score == 0) { ret res[usize, FontError].err{FontError.no_unicode_cmap{}}; }
    ret res[usize, FontError].ok{best_off};
}

# rank a (platform, encoding) pair for unicode coverage, 0 meaning unusable
fun encoding_score(platform: u16, encoding: u16) i32 {
    # windows full unicode (UCS-4)
    if (platform == 3 && encoding == 10) { ret 4; }
    # unicode platform, full repertoire
    if (platform == 0 && (encoding == 4 || encoding == 6)) { ret 4; }
    # windows BMP unicode
    if (platform == 3 && encoding == 1) { ret 3; }
    # unicode platform, BMP or earlier
    if (platform == 0 && encoding <= 3) { ret 3; }
    # windows symbol
    if (platform == 3 && encoding == 0) { ret 2; }
    ret 0;
}

# map a codepoint to a glyph index through a selected subtable
#
# dispatches on the subtable format: 4 for segmented BMP coverage, 12 for
# segmented full coverage. an unmapped codepoint yields glyph 0.
# ---
# data:      pointer to the first byte of the file
# len:       number of bytes addressable through data
# sub_off:   absolute byte offset of the cmap subtable
# codepoint: the unicode codepoint to map
# ret:       the glyph index (0 when unmapped), or cmap_format or truncated
pub fun lookup(data: *u8, len: usize, sub_off: usize, codepoint: u32) res[u16, FontError] {
    val format: res[u16, FontError] = read.read_u16(data, len, sub_off);
    if (sel format.err) { ret res[u16, FontError].err{format.err}; }

    if (format.ok == 4)  { ret lookup_4(data, len, sub_off, codepoint); }
    if (format.ok == 12) { ret lookup_12(data, len, sub_off, codepoint); }
    ret res[u16, FontError].err{FontError.cmap_format{format.ok}};
}

# format 4: segmented coverage of the basic multilingual plane
fun lookup_4(data: *u8, len: usize, sub_off: usize, codepoint: u32) res[u16, FontError] {
    # format 4 covers only U+0000..U+FFFF, so anything above is unmapped.
    if (codepoint > 0xFFFF) { ret res[u16, FontError].ok{0}; }
    val c: u16 = codepoint::u16;

    val seg_x2: res[u16, FontError] = read.read_u16(data, len, sub_off + 6);
    if (sel seg_x2.err) { ret res[u16, FontError].err{seg_x2.err}; }
    val seg_count: usize = (seg_x2.ok::usize) / 2;

    val end_base:   usize = sub_off + 14;
    val start_base: usize = end_base + seg_x2.ok::usize + 2;
    val delta_base: usize = start_base + seg_x2.ok::usize;
    val range_base: usize = delta_base + seg_x2.ok::usize;

    var i: usize = 0;
    for (i < seg_count) {
        val end_code: res[u16, FontError] = read.read_u16(data, len, end_base + i * 2);
        if (sel end_code.err) { ret res[u16, FontError].err{end_code.err}; }
        if (c <= end_code.ok) {
            ret segment_4(data, len, i, start_base, delta_base, range_base, c);
        }
        i = i + 1;
    }

    ret res[u16, FontError].ok{0};
}

# resolve a BMP code through the format 4 segment whose end code covers it
fun segment_4(data: *u8, len: usize, i: usize, start_base: usize, delta_base: usize, range_base: usize, c: u16) res[u16, FontError] {
    val start_code: res[u16, FontError] = read.read_u16(data, len, start_base + i * 2);
    if (sel start_code.err) { ret res[u16, FontError].err{start_code.err}; }
    if (c < start_code.ok)  { ret res[u16, FontError].ok{0}; }

    val id_delta: res[i16, FontError] = read.read_i16(data, len, delta_base + i * 2);
    if (sel id_delta.err) { ret res[u16, FontError].err{id_delta.err}; }
    val range_at:  usize               = range_base + i * 2;
    val range_off: res[u16, FontError] = read.read_u16(data, len, range_at);
    if (sel range_off.err) { ret res[u16, FontError].err{range_off.err}; }

    # idDelta is added modulo 65536. reinterpret its bits as u16 so a negative
    # delta contributes its two's-complement value to the sum.
    val delta: u32 = id_delta.ok:~u16::u32;
    if (range_off.ok == 0) {
        ret res[u16, FontError].ok{(c::u32 + delta)::u16};
    }

    # idRangeOffset indexes forward from its own slot into glyphIdArray.
    val glyph_at: usize               = range_at + range_off.ok::usize + (c - start_code.ok)::usize * 2;
    val raw:      res[u16, FontError] = read.read_u16(data, len, glyph_at);
    if (sel raw.err) { ret res[u16, FontError].err{raw.err}; }
    if (raw.ok == 0) { ret res[u16, FontError].ok{0}; }
    ret res[u16, FontError].ok{(raw.ok::u32 + delta)::u16};
}

fun w16(buf: *u8, off: usize, v: u16) {
    buf[off]     = (v >> 8)::u8;
    buf[off + 1] = (v & 0xFF)::u8;
}

fun w32(buf: *u8, off: usize, v: u32) {
    buf[off]     = (v >> 24)::u8;
    buf[off + 1] = ((v >> 16) & 0xFF)::u8;
    buf[off + 2] = ((v >> 8) & 0xFF)::u8;
    buf[off + 3] = (v & 0xFF)::u8;
}

# a format 4 subtable: A-C contiguous via idDelta, X via glyphIdArray
var f4: [64]u8;

fun build_f4() {
    val p: *u8 = ?f4[0];
    w16(p, 0, 4); # format
    w16(p, 2, 42); # length
    w16(p, 4, 0); # language
    w16(p, 6, 6); # segCountX2 (3 segments)
    w16(p, 8, 0);
    w16(p, 10, 0);
    w16(p, 12, 0);
    # endCode[3]
    w16(p, 14, 0x43);
    w16(p, 16, 0x58);
    w16(p, 18, 0xFFFF);
    w16(p, 20, 0); # reservedPad
    # startCode[3]
    w16(p, 22, 0x41);
    w16(p, 24, 0x58);
    w16(p, 26, 0xFFFF);
    # idDelta[3]
    w16(p, 28, 0xFFC2); # -62: 'A'(0x41) -> 3
    w16(p, 30, 0); # seg1 maps through glyphIdArray
    w16(p, 32, 1); # terminator
    # idRangeOffset[3]
    w16(p, 34, 0);
    w16(p, 36, 4); # seg1: slot@36 + 4 -> glyphIdArray@40
    w16(p, 38, 0);
    # glyphIdArray
    w16(p, 40, 9); # 'X' -> 9
}

# test whether a lookup succeeded with exactly this glyph
fun maps(r: res[u16, FontError], glyph: u16) bool {
    if (sel r.ok) { ret r.ok == glyph; }
    ret false;
}

test "cmap: format 4 idDelta mapping" {
    build_f4();
    if (!maps(lookup(?f4[0], 64, 0, 0x41), 3)) { ret 1; }
    if (!maps(lookup(?f4[0], 64, 0, 0x42), 4)) { ret 1; }
    if (!maps(lookup(?f4[0], 64, 0, 0x43), 5)) { ret 1; }
    ret 0;
}

test "cmap: format 4 glyphIdArray mapping" {
    build_f4();
    if (!maps(lookup(?f4[0], 64, 0, 0x58), 9)) { ret 1; }
    ret 0;
}

test "cmap: format 4 unmapped yields glyph 0" {
    build_f4();
    if (!maps(lookup(?f4[0], 64, 0, 0x44), 0)) { ret 1; }
    # beyond the BMP is unmapped in format 4
    if (!maps(lookup(?f4[0], 64, 0, 0x10000), 0)) { ret 1; }
    ret 0;
}

# a format 4 subtable wrapped in a cmap table with one encoding record
var cmap_buf: [128]u8;

fun build_cmap() {
    val p: *u8 = ?cmap_buf[0];
    w16(p, 0, 0); # version
    w16(p, 2, 1); # numTables
    w16(p, 4, 3); # platformID = windows
    w16(p, 6, 1); # encodingID = BMP unicode
    w32(p, 8, 12); # subtable offset (relative to cmap start)
    build_f4();
    var i: usize = 0;
    for (i < 64) {
        cmap_buf[12 + i] = f4[i];
        i                = i + 1;
    }
}

test "cmap: select subtable and map" {
    build_cmap();
    val sub: res[usize, FontError] = select_subtable(?cmap_buf[0], 128, 0);
    if (!sel sub.ok)                                       { ret 1; }
    if (sub.ok != 12)                                      { ret 2; }
    if (!maps(lookup(?cmap_buf[0], 128, sub.ok, 0x42), 4)) { ret 3; }
    ret 0;
}

test "cmap: no unicode subtable rejected" {
    build_cmap();
    w16(?cmap_buf[0], 4, 1); # platformID = macintosh, not unicode
    w16(?cmap_buf[0], 6, 0);
    val sub: res[usize, FontError] = select_subtable(?cmap_buf[0], 128, 0);
    if (!sel sub.err)                 { ret 1; }
    if (!sel sub.err.no_unicode_cmap) { ret 2; }
    ret 0;
}

# format 12: segmented coverage across the full codepoint range
fun lookup_12(data: *u8, len: usize, sub_off: usize, codepoint: u32) res[u16, FontError] {
    val num_groups: res[u32, FontError] = read.read_u32(data, len, sub_off + 12);
    if (sel num_groups.err) { ret res[u16, FontError].err{num_groups.err}; }

    var i: usize = 0;
    for (i < num_groups.ok::usize) {
        val g:          usize               = sub_off + 16 + i * 12;
        val start_char: res[u32, FontError] = read.read_u32(data, len, g);
        if (sel start_char.err) { ret res[u16, FontError].err{start_char.err}; }
        val end_char: res[u32, FontError] = read.read_u32(data, len, g + 4);
        if (sel end_char.err) { ret res[u16, FontError].err{end_char.err}; }
        if (codepoint >= start_char.ok && codepoint <= end_char.ok) {
            val start_glyph: res[u32, FontError] = read.read_u32(data, len, g + 8);
            if (sel start_glyph.err) { ret res[u16, FontError].err{start_glyph.err}; }
            ret res[u16, FontError].ok{(start_glyph.ok + (codepoint - start_char.ok))::u16};
        }
        i = i + 1;
    }

    ret res[u16, FontError].ok{0};
}

# two groups: a BMP range and a single astral codepoint
var f12: [40]u8;

fun build_f12() {
    val p: *u8 = ?f12[0];
    w16(p, 0, 12); # format
    w16(p, 2, 0); # reserved
    w32(p, 4, 40); # length
    w32(p, 8, 0); # language
    w32(p, 12, 2); # numGroups
    # group 0: U+0100..U+0102 -> glyphs 10..12
    w32(p, 16, 0x100);
    w32(p, 20, 0x102);
    w32(p, 24, 10);
    # group 1: U+1F600 -> glyph 20
    w32(p, 28, 0x1F600);
    w32(p, 32, 0x1F600);
    w32(p, 36, 20);
}

test "cmap: format 12 range mapping" {
    build_f12();
    if (!maps(lookup(?f12[0], 40, 0, 0x101), 11)) { ret 1; }
    ret 0;
}

test "cmap: format 12 astral codepoint" {
    build_f12();
    if (!maps(lookup(?f12[0], 40, 0, 0x1F600), 20)) { ret 1; }
    ret 0;
}

test "cmap: format 12 unmapped yields glyph 0" {
    build_f12();
    if (!maps(lookup(?f12[0], 40, 0, 0x200), 0)) { ret 1; }
    ret 0;
}

test "cmap: unsupported subtable format rejected" {
    build_f12();
    w16(?f12[0], 0, 6);
    val r: res[u16, FontError] = lookup(?f12[0], 40, 0, 0x101);
    if (!sel r.err)             { ret 1; }
    if (!sel r.err.cmap_format) { ret 2; }
    if (r.err.cmap_format != 6) { ret 3; }
    ret 0;
}
