# glyph outline extraction
#
# a simple glyph in the glyf table is a header (contour count and bounding box)
# followed by contour end indices, hinting instructions, and a compact
# flags/x/y coordinate encoding. this module reads that encoding into an explicit
# list of on/off-curve points and the index at which each contour ends. curves are
# quadratic: a point is on the curve or an off-curve control point, per its flag.
#
# a composite glyph (contour count below zero) instead stores a chain of component
# records, each naming another glyph, a placement offset, and an optional 2x2
# transform. this module decodes one record at a time and supplies the affine
# machinery to place and nest them; resolving a component index back to its glyph
# data needs the loca table, so the recursive walk lives in font.info. every read
# is bounds-checked through font.read, so a truncated or inconsistent glyph
# reports failure rather than reading out of bounds.

use font.error.FontError;
use font.read;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

# simple-glyph point flag bits
val ON_CURVE:      u8 = 0x01;
val X_SHORT:       u8 = 0x02;
val Y_SHORT:       u8 = 0x04;
val REPEAT:        u8 = 0x08;
val X_SAME_OR_POS: u8 = 0x10;
val Y_SAME_OR_POS: u8 = 0x20;

# composite-glyph component flag bits
# ---
# args are signed 16-bit rather than 8-bit
pub val ARG_1_AND_2_ARE_WORDS: u16 = 0x0001;
# args are a placement offset; otherwise they are point indices to match
pub val ARGS_ARE_XY_VALUES: u16 = 0x0002;
# round the placement offset to the nearest design-unit grid line
pub val ROUND_XY_TO_GRID: u16 = 0x0004;
# one F2Dot14 scale applied to both axes
pub val WE_HAVE_A_SCALE: u16 = 0x0008;
# another component record follows this one
pub val MORE_COMPONENTS: u16 = 0x0020;
# separate F2Dot14 x and y scales
pub val WE_HAVE_AN_X_AND_Y_SCALE: u16 = 0x0040;
# a full F2Dot14 2x2 matrix
pub val WE_HAVE_A_TWO_BY_TWO: u16 = 0x0080;
# scale the placement offset by the component transform
pub val SCALED_COMPONENT_OFFSET: u16 = 0x0800;
# leave the placement offset unscaled, overriding the flag above
pub val UNSCALED_COMPONENT_OFFSET: u16 = 0x1000;

# one outline point in font units
# ---
# x:        x coordinate in font design units
# y:        y coordinate in font design units
# on_curve: true for an on-curve point, false for a quadratic control point
pub rec Point {
    x:        i16;
    y:        i16;
    on_curve: bool;
}

# a glyph's header, as stored in the glyf table
#
# the bounding box here is whatever the font file claims. placement and sizing
# never read it: outline_bounds over the resolved outline is the one source.
# ---
# num_contours: contour count; negative marks a composite glyph
# x_min, y_min: lower-left corner of the stored bounding box
# x_max, y_max: upper-right corner of the stored bounding box
pub rec GlyphHeader {
    num_contours: i16;
    x_min:        i16;
    y_min:        i16;
    x_max:        i16;
    y_max:        i16;
}

# the sizes an extracted simple glyph produced
# ---
# num_contours: number of contours written to the ends buffer
# num_points:   number of points written to the points buffer
pub rec Outline {
    num_contours: u16;
    num_points:   u16;
}

# the extent of a resolved outline in font design units
# ---
# x_min, y_min: lower-left corner
# x_max, y_max: upper-right corner
pub rec Bounds {
    x_min: i16;
    y_min: i16;
    x_max: i16;
    y_max: i16;
}

# compute the bounding box of a resolved outline
#
# the one source of a glyph's extent, for simple and composite glyphs alike. it
# spans every point, on-curve and control alike, which is how the format defines
# a glyph's box, so a font whose stored boxes are correct gets the same numbers
# back. a font whose stored box is stale or zero gets the box its outline actually
# occupies. an outline with no points has no extent.
# ---
# pts:        the resolved points, as glyph_outline writes them
# num_points: how many of them there are
# ret:        the box, or none for an empty outline
pub fun outline_bounds(pts: *Point, num_points: u16) opt[Bounds] {
    if (num_points == 0) { ret opt[Bounds].none{}; }
    var b: Bounds = Bounds{x_min: pts[0].x, y_min: pts[0].y, x_max: pts[0].x, y_max: pts[0].y};
    var i: usize  = 1;
    for (i < num_points::usize) {
        if (pts[i].x < b.x_min) { b.x_min = pts[i].x; }
        if (pts[i].y < b.y_min) { b.y_min = pts[i].y; }
        if (pts[i].x > b.x_max) { b.x_max = pts[i].x; }
        if (pts[i].y > b.y_max) { b.y_max = pts[i].y; }
        i = i + 1;
    }
    ret opt[Bounds].some{b};
}

# an affine placement of one outline into another's design space
#
# a point maps as x' = a*x + c*y + dx, y' = b*x + d*y + dy, matching the column
# convention the composite-glyph spec states its 2x2 matrix in.
# ---
# a, b, c, d: the 2x2 linear part
# dx, dy:     the translation in font design units
pub rec Xform {
    a:  f32;
    b:  f32;
    c:  f32;
    d:  f32;
    dx: f32;
    dy: f32;
}

# one component record of a composite glyph
# ---
# glyph: index of the glyph this component draws
# flags: the record's raw component flags
# m:     the component's placement transform
# next:  byte offset just past the record, where the next one begins
pub rec Component {
    glyph: u16;
    flags: u16;
    m:     Xform;
    next:  usize;
}

# write the identity placement
# ---
# out: receives a transform that leaves every point where it is
pub fun xform_identity(out: *Xform) {
    out[0] = Xform{a: 1.0, b: 0.0, c: 0.0, d: 1.0, dx: 0.0, dy: 0.0};
}

# compose two placements: apply inner first, then outer
#
# nesting a composite inside a composite stacks transforms this way, so a
# component's points land where the outermost glyph places them.
# ---
# outer: the enclosing placement
# inner: the placement applied to the points first
# out:   receives the combined transform
pub fun xform_compose(outer: *Xform, inner: *Xform, out: *Xform) {
    var m: Xform;
    m.a    = outer.a * inner.a + outer.c * inner.b;
    m.b    = outer.b * inner.a + outer.d * inner.b;
    m.c    = outer.a * inner.c + outer.c * inner.d;
    m.d    = outer.b * inner.c + outer.d * inner.d;
    m.dx   = outer.a * inner.dx + outer.c * inner.dy + outer.dx;
    m.dy   = outer.b * inner.dx + outer.d * inner.dy + outer.dy;
    out[0] = m;
}

# round to nearest, halves away from zero
fun round_f32(v: f32) f32 {
    if (v >= 0.0) { ret (v + 0.5)::i32::f32; }
    ret (v - 0.5)::i32::f32;
}

# round to nearest and saturate into the design-unit coordinate range
fun to_coord(v: f32) i16 {
    val r: f32 = round_f32(v);
    if (r > 32767.0)  { ret 32767; }
    if (r < -32768.0) { ret -32768; }
    ret r::i32::i16;
}

# apply a placement to points in place
#
# coordinates stay in font design units, so each transformed point is rounded back
# to the nearest unit; a transform that pushes a point outside the design-unit
# range saturates rather than wrapping.
# ---
# m:   the placement to apply
# pts: the points to transform
# n:   number of points in pts
pub fun xform_apply(m: *Xform, pts: *Point, n: usize) {
    var i: usize = 0;
    for (i < n) {
        val x: f32 = pts[i].x::f32;
        val y: f32 = pts[i].y::f32;
        pts[i].x = to_coord(m.a * x + m.c * y + m.dx);
        pts[i].y = to_coord(m.b * x + m.d * y + m.dy);
        i        = i + 1;
    }
}

# read a glyph's header at goff
# ---
# data: pointer to the first byte of the file
# len:  number of bytes addressable through data
# goff: absolute byte offset of the glyph's data
# ret:  the header, or truncated
pub fun glyph_header(data: *u8, len: usize, goff: usize) res[GlyphHeader, FontError] {
    val contours: res[i16, FontError] = read.read_i16(data, len, goff);
    if (sel contours.err) { ret res[GlyphHeader, FontError].err{contours.err}; }
    val x_min: res[i16, FontError] = read.read_i16(data, len, goff + 2);
    if (sel x_min.err) { ret res[GlyphHeader, FontError].err{x_min.err}; }
    val y_min: res[i16, FontError] = read.read_i16(data, len, goff + 4);
    if (sel y_min.err) { ret res[GlyphHeader, FontError].err{y_min.err}; }
    val x_max: res[i16, FontError] = read.read_i16(data, len, goff + 6);
    if (sel x_max.err) { ret res[GlyphHeader, FontError].err{x_max.err}; }
    val y_max: res[i16, FontError] = read.read_i16(data, len, goff + 8);
    if (sel y_max.err) { ret res[GlyphHeader, FontError].err{y_max.err}; }
    ret res[GlyphHeader, FontError].ok{GlyphHeader{
        num_contours: contours.ok,
        x_min:        x_min.ok,
        y_min:        y_min.ok,
        x_max:        x_max.ok,
        y_max:        y_max.ok,
    }};
}

# report whether a header denotes a composite glyph
# ---
# info: a glyph header
# ret:  true when the glyph references component glyphs rather than storing contours
pub fun is_composite(info: *GlyphHeader) bool {
    ret info.num_contours < 0;
}

# byte offset of a composite glyph's first component record, past the 10-byte header
pub val COMPONENTS_OFFSET: usize = 10;

# read one F2Dot14 value into a transform slot, returning the offset past it
fun read_f2dot14_into(data: *u8, len: usize, off: usize, slot: *f32) res[usize, FontError] {
    val v: res[f32, FontError] = read.read_f2dot14(data, len, off);
    if (sel v.err) { ret res[usize, FontError].err{v.err}; }
    slot[0] = v.ok;
    ret res[usize, FontError].ok{off + 2};
}

# read one component record of a composite glyph
#
# decodes the record's flags, component glyph index, and placement into a
# transform ready to apply to that component's points. records are variable
# length, so the component's next field reports where the next one begins, and
# the caller stops when the record's MORE_COMPONENTS flag is clear. when
# ARGS_ARE_XY_VALUES is clear the two args are point indices to align rather than
# an offset, and they are reported verbatim in the transform's translation for a
# caller that rejects or handles that placement itself.
# ---
# data: pointer to the first byte of the file
# len:  number of bytes addressable through data
# off:  absolute byte offset of the component record
# ret:  the decoded component, or truncated
pub fun read_component(data: *u8, len: usize, off: usize) res[Component, FontError] {
    var c:     Component;
    val flags: res[u16, FontError] = read.read_u16(data, len, off);
    if (sel flags.err) { ret res[Component, FontError].err{flags.err}; }
    val glyph: res[u16, FontError] = read.read_u16(data, len, off + 2);
    if (sel glyph.err) { ret res[Component, FontError].err{glyph.err}; }
    c.flags = flags.ok;
    c.glyph = glyph.ok;

    val xy:     bool  = (c.flags & ARGS_ARE_XY_VALUES) != 0;
    var cursor: usize = off + 4;
    var arg1:   f32   = 0.0;
    var arg2:   f32   = 0.0;

    if ((c.flags & ARG_1_AND_2_ARE_WORDS) != 0) {
        val w1: res[u16, FontError] = read.read_u16(data, len, cursor);
        if (sel w1.err) { ret res[Component, FontError].err{w1.err}; }
        val w2: res[u16, FontError] = read.read_u16(data, len, cursor + 2);
        if (sel w2.err) { ret res[Component, FontError].err{w2.err}; }
        if (xy) {
            arg1 = w1.ok:~i16::f32;
            arg2 = w2.ok:~i16::f32;
        }
        or {
            arg1 = w1.ok::f32;
            arg2 = w2.ok::f32;
        }
        cursor = cursor + 4;
    }
    or {
        val b1: res[u8, FontError] = read.read_u8(data, len, cursor);
        if (sel b1.err) { ret res[Component, FontError].err{b1.err}; }
        val b2: res[u8, FontError] = read.read_u8(data, len, cursor + 1);
        if (sel b2.err) { ret res[Component, FontError].err{b2.err}; }
        if (xy) {
            arg1 = b1.ok:~i8::f32;
            arg2 = b2.ok:~i8::f32;
        }
        or {
            arg1 = b1.ok::f32;
            arg2 = b2.ok::f32;
        }
        cursor = cursor + 2;
    }

    c.m.a = 1.0;
    c.m.b = 0.0;
    c.m.c = 0.0;
    c.m.d = 1.0;

    # each present scale field is read in order, and the cursor lands past the last.
    var slots: [4]*f32;
    var count: usize = 0;
    if ((c.flags & WE_HAVE_A_SCALE) != 0) {
        slots[0] = ?c.m.a;
        count    = 1;
    }
    or ((c.flags & WE_HAVE_AN_X_AND_Y_SCALE) != 0) {
        slots[0] = ?c.m.a;
        slots[1] = ?c.m.d;
        count    = 2;
    }
    or ((c.flags & WE_HAVE_A_TWO_BY_TWO) != 0) {
        slots[0] = ?c.m.a;
        slots[1] = ?c.m.b;
        slots[2] = ?c.m.c;
        slots[3] = ?c.m.d;
        count    = 4;
    }
    var i: usize = 0;
    for (i < count) {
        val at: res[usize, FontError] = read_f2dot14_into(data, len, cursor, slots[i]);
        if (sel at.err) { ret res[Component, FontError].err{at.err}; }
        cursor = at.ok;
        i      = i + 1;
    }
    if ((c.flags & WE_HAVE_A_SCALE) != 0) { c.m.d = c.m.a; }

    c.m.dx = arg1;
    c.m.dy = arg2;
    if (xy) {
        # an offset is stated in the composite's space by default. SCALED_COMPONENT_OFFSET
        # states it in the component's own space, so it passes through the 2x2 first.
        if ((c.flags & SCALED_COMPONENT_OFFSET) != 0 && (c.flags & UNSCALED_COMPONENT_OFFSET) == 0) {
            c.m.dx = c.m.a * arg1 + c.m.c * arg2;
            c.m.dy = c.m.b * arg1 + c.m.d * arg2;
        }
        if ((c.flags & ROUND_XY_TO_GRID) != 0) {
            c.m.dx = round_f32(c.m.dx);
            c.m.dy = round_f32(c.m.dy);
        }
    }

    c.next = cursor;
    ret res[Component, FontError].ok{c};
}

# read the point count of a simple glyph from its last contour end index
#
# the point count is one past the highest index in endPtsOfContours, and a caller
# sizes its point buffer from this before extracting. an empty glyph has none.
# ---
# data:         pointer to the first byte of the file
# len:          number of bytes addressable through data
# goff:         absolute byte offset of the glyph's data
# num_contours: the glyph's contour count, from its header
# ret:          the point count, or composite_glyph, too_many_points or truncated
pub fun point_count(data: *u8, len: usize, goff: usize, num_contours: i16) res[u16, FontError] {
    if (num_contours < 0)  { ret res[u16, FontError].err{FontError.composite_glyph{}}; }
    if (num_contours == 0) { ret res[u16, FontError].ok{0}; }
    val last:    usize               = goff + 10 + (num_contours::usize - 1) * 2;
    val end_idx: res[u16, FontError] = read.read_u16(data, len, last);
    if (sel end_idx.err)      { ret res[u16, FontError].err{end_idx.err}; }
    if (end_idx.ok == 0xFFFF) { ret res[u16, FontError].err{FontError.too_many_points{}}; }
    ret res[u16, FontError].ok{end_idx.ok + 1};
}

# read one coordinate block of a simple glyph into the points' x or y
#
# short and same-or-positive flag bits select how each delta is stored, and the
# running sum of the deltas is the absolute coordinate.
fun read_coords(data: *u8, len: usize, cursor: usize, pts: *Point, np: usize, short_bit: u8, same_bit: u8, is_x: bool) res[usize, FontError] {
    var at:  usize = cursor;
    var acc: i32   = 0;
    var i:   usize = 0;
    for (i < np) {
        val flag: u8 = pts[i].on_curve;
        if ((flag & short_bit) != 0) {
            val d: res[u8, FontError] = read.read_u8(data, len, at);
            if (sel d.err) { ret res[usize, FontError].err{d.err}; }
            at = at + 1;
            if ((flag & same_bit) != 0) { acc = acc + d.ok::i32; }
            or                          { acc = acc - d.ok::i32; }
        }
        or ((flag & same_bit) == 0) {
            val w: res[i16, FontError] = read.read_i16(data, len, at);
            if (sel w.err) { ret res[usize, FontError].err{w.err}; }
            at  = at + 2;
            acc = acc + w.ok::i32;
        }
        if (is_x) { pts[i].x = acc::i16; }
        or        { pts[i].y = acc::i16; }
        i = i + 1;
    }
    ret res[usize, FontError].ok{at};
}

# extract a simple glyph's contours into caller-provided buffers
#
# writes each contour's inclusive end point index into ends and every point
# (absolute coordinates, on/off-curve flag) into pts. an empty glyph (zero
# contours) succeeds with zero counts.
# ---
# data:     pointer to the first byte of the file
# len:      number of bytes addressable through data
# goff:     absolute byte offset of the glyph's data
# pts:      buffer receiving the extracted points
# pts_cap:  capacity of pts in points
# ends:     buffer receiving each contour's end point index
# ends_cap: capacity of ends in entries
# ret:      the written contour and point counts, or composite_glyph, contours_full,
#           points_full, too_many_points or truncated
pub fun extract_simple(data: *u8, len: usize, goff: usize, pts: *Point, pts_cap: usize, ends: *u16, ends_cap: usize) res[Outline, FontError] {
    val nc_raw: res[i16, FontError] = read.read_i16(data, len, goff);
    if (sel nc_raw.err) { ret res[Outline, FontError].err{nc_raw.err}; }
    if (nc_raw.ok < 0)  { ret res[Outline, FontError].err{FontError.composite_glyph{}}; }
    if (nc_raw.ok == 0) { ret res[Outline, FontError].ok{Outline{num_contours: 0, num_points: 0}}; }

    val nc: usize = nc_raw.ok::usize;
    if (nc > ends_cap) { ret res[Outline, FontError].err{FontError.contours_full{}}; }

    var i: usize = 0;
    for (i < nc) {
        val end: res[u16, FontError] = read.read_u16(data, len, goff + 10 + i * 2);
        if (sel end.err) { ret res[Outline, FontError].err{end.err}; }
        ends[i] = end.ok;
        i       = i + 1;
    }

    val np: usize = ends[nc - 1]::usize + 1;
    if (np > 0xFFFF)  { ret res[Outline, FontError].err{FontError.too_many_points{}}; }
    if (np > pts_cap) { ret res[Outline, FontError].err{FontError.points_full{}}; }

    val ins_len: res[u16, FontError] = read.read_u16(data, len, goff + 10 + nc * 2);
    if (sel ins_len.err) { ret res[Outline, FontError].err{ins_len.err}; }

    # cursor walks the flags block, then the x block, then the y block in turn.
    var cursor: usize = goff + 10 + nc * 2 + 2 + ins_len.ok::usize;

    # expand the run-length flags, stashing each point's full flag byte in
    # on_curve for the coordinate passes. it is reduced to the on-curve bit at the end.
    i = 0;
    for (i < np) {
        val flag: res[u8, FontError] = read.read_u8(data, len, cursor);
        if (sel flag.err) { ret res[Outline, FontError].err{flag.err}; }
        cursor          = cursor + 1;
        pts[i].on_curve = flag.ok;
        i               = i + 1;

        if ((flag.ok & REPEAT) != 0) {
            val reps: res[u8, FontError] = read.read_u8(data, len, cursor);
            if (sel reps.err) { ret res[Outline, FontError].err{reps.err}; }
            cursor = cursor + 1;
            var r: u8 = 0;
            for (r < reps.ok) {
                if (i < np) {
                    pts[i].on_curve = flag.ok;
                    i               = i + 1;
                }
                r = r + 1;
            }
        }
    }

    val after_x: res[usize, FontError] = read_coords(data, len, cursor, pts, np, X_SHORT, X_SAME_OR_POS, true);
    if (sel after_x.err) { ret res[Outline, FontError].err{after_x.err}; }
    val after_y: res[usize, FontError] = read_coords(data, len, after_x.ok, pts, np, Y_SHORT, Y_SAME_OR_POS, false);
    if (sel after_y.err) { ret res[Outline, FontError].err{after_y.err}; }

    # reduce the stashed flag bytes to the on-curve bit.
    i = 0;
    for (i < np) {
        pts[i].on_curve = (pts[i].on_curve & ON_CURVE);
        i               = i + 1;
    }

    ret res[Outline, FontError].ok{Outline{num_contours: nc_raw.ok::u16, num_points: np::u16}};
}

fun w16(buf: *u8, off: usize, v: u16) {
    buf[off]     = (v >> 8)::u8;
    buf[off + 1] = (v & 0xFF)::u8;
}

var glyph_buf: [64]u8;

# build a triangle: on-curve points (100,100), (300,100), (200,400) in one contour,
# exercising short +, short -, same-as-previous, and i16 coordinate deltas
fun build_triangle() {
    val p: *u8 = ?glyph_buf[0];
    w16(p, 0, 1); # numberOfContours
    w16(p, 2, 100); # xMin
    w16(p, 4, 100); # yMin
    w16(p, 6, 300); # xMax
    w16(p, 8, 400); # yMax
    w16(p, 10, 2); # endPtsOfContours[0] = 2 (3 points)
    w16(p, 12, 0); # instructionLength
    glyph_buf[14] = 0x37; # p0: on, x short +, y short +
    glyph_buf[15] = 0x33; # p1: on, x short +, y same
    glyph_buf[16] = 0x03; # p2: on, x short -, y i16
    glyph_buf[17] = 100; # p0 x = +100
    glyph_buf[18] = 200; # p1 x = +200
    glyph_buf[19] = 100; # p2 x = -100
    glyph_buf[20] = 100; # p0 y = +100
    w16(p, 21, 300); # p2 y = +300 (i16)
}

var tri_pts:  [8]Point;
var tri_ends: [4]u16;

test "glyf: header and composite detection" {
    build_triangle();
    val info: res[GlyphHeader, FontError] = glyph_header(?glyph_buf[0], 64, 0);
    if (!sel info.ok)                                 { ret 1; }
    if (info.ok.num_contours != 1)                    { ret 2; }
    if (info.ok.x_max != 300 || info.ok.y_max != 400) { ret 3; }
    if (is_composite(?info.ok))                       { ret 4; }
    ret 0;
}

test "glyf: point count" {
    build_triangle();
    val n: res[u16, FontError] = point_count(?glyph_buf[0], 64, 0, 1);
    if (!sel n.ok) { ret 1; }
    if (n.ok != 3) { ret 2; }
    val empty: res[u16, FontError] = point_count(?glyph_buf[0], 64, 0, 0);
    if (!sel empty.ok) { ret 3; }
    if (empty.ok != 0) { ret 4; }
    val composite: res[u16, FontError] = point_count(?glyph_buf[0], 64, 0, -1);
    if (!sel composite.err)                 { ret 5; }
    if (!sel composite.err.composite_glyph) { ret 6; }
    ret 0;
}

test "glyf: extract triangle points" {
    build_triangle();
    val r: res[Outline, FontError] = extract_simple(?glyph_buf[0], 64, 0, ?tri_pts[0], 8, ?tri_ends[0], 4);
    if (!sel r.ok)                                  { ret 1; }
    if (r.ok.num_contours != 1)                     { ret 1; }
    if (r.ok.num_points != 3)                       { ret 1; }
    if (tri_ends[0] != 2)                           { ret 1; }
    if (tri_pts[0].x != 100 || tri_pts[0].y != 100) { ret 1; }
    if (tri_pts[1].x != 300 || tri_pts[1].y != 100) { ret 1; }
    if (tri_pts[2].x != 200 || tri_pts[2].y != 400) { ret 1; }
    if (!tri_pts[0].on_curve)                       { ret 1; }
    if (!tri_pts[2].on_curve)                       { ret 1; }
    ret 0;
}

test "glyf: too few points capacity rejected" {
    build_triangle();
    val r: res[Outline, FontError] = extract_simple(?glyph_buf[0], 64, 0, ?tri_pts[0], 2, ?tri_ends[0], 4);
    if (!sel r.err)             { ret 1; }
    if (!sel r.err.points_full) { ret 2; }
    ret 0;
}

test "glyf: too few contours capacity rejected" {
    build_triangle();
    val r: res[Outline, FontError] = extract_simple(?glyph_buf[0], 64, 0, ?tri_pts[0], 8, ?tri_ends[0], 0);
    if (!sel r.err)               { ret 1; }
    if (!sel r.err.contours_full) { ret 2; }
    ret 0;
}

test "glyf: truncated coordinates rejected" {
    build_triangle();
    # the last y delta is an i16 at 21..23
    val r: res[Outline, FontError] = extract_simple(?glyph_buf[0], 22, 0, ?tri_pts[0], 8, ?tri_ends[0], 4);
    if (!sel r.err)            { ret 1; }
    if (!sel r.err.truncated)  { ret 2; }
    if (r.err.truncated != 21) { ret 3; }
    ret 0;
}

test "glyf: composite rejected by extract" {
    build_triangle();
    w16(?glyph_buf[0], 0, 0xFFFF); # numberOfContours = -1
    val r: res[Outline, FontError] = extract_simple(?glyph_buf[0], 64, 0, ?tri_pts[0], 8, ?tri_ends[0], 4);
    if (!sel r.err)                 { ret 1; }
    if (!sel r.err.composite_glyph) { ret 2; }
    ret 0;
}

# dejavu sans (2048 units per em) verbatim: the 24 bytes of `dotbelowcomb`, a
# one-contour rectangle whose coordinate encoding uses an i16 delta, a positive
# short, a same-as-previous, and a negative short on each axis
var real_simple: [24]u8 = [24]u8{
    0x00, 0x01, 0xFD, 0xA2, 0xFE, 0x89, 0xFE, 0x5A,
    0xFF, 0x73, 0x00, 0x03, 0x00, 0x00, 0x05, 0x33,
    0x15, 0x23, 0xFD, 0xA2, 0xB8, 0xB8, 0x8D, 0xEA
};

# dejavu sans verbatim: the 24 bytes of `uni1E37` (l with dot below), a composite
# of `dotbelowcomb` at x+807 and `l` at x+11
var real_composite: [24]u8 = [24]u8{
    0xFF, 0xFF, 0x00, 0xC9, 0xFE, 0x89, 0x01, 0x84,
    0x06, 0x14, 0x10, 0x27, 0x02, 0xD4, 0x03, 0x27,
    0x00, 0x00, 0x10, 0x06, 0x00, 0x4F, 0x0B, 0x00
};

test "glyf: real font simple glyph bytes" {
    val r: res[Outline, FontError] = extract_simple(?real_simple[0], 24, 0, ?tri_pts[0], 8, ?tri_ends[0], 4);
    if (!sel r.ok)                                      { ret 1; }
    if (r.ok.num_contours != 1 || r.ok.num_points != 4) { ret 1; }
    if (tri_ends[0] != 3)                               { ret 1; }
    if (tri_pts[0].x != -606 || tri_pts[0].y != -141)   { ret 1; }
    if (tri_pts[1].x != -422 || tri_pts[1].y != -141)   { ret 1; }
    if (tri_pts[2].x != -422 || tri_pts[2].y != -375)   { ret 1; }
    if (tri_pts[3].x != -606 || tri_pts[3].y != -375)   { ret 1; }
    ret 0;
}

test "glyf: real font composite component records" {
    val p:    *u8                         = ?real_composite[0];
    val info: res[GlyphHeader, FontError] = glyph_header(p, 24, 0);
    if (!sel info.ok)                                  { ret 1; }
    if (!is_composite(?info.ok))                       { ret 1; }
    if (info.ok.x_min != 201 || info.ok.y_min != -375) { ret 1; }
    if (info.ok.x_max != 388 || info.ok.y_max != 1556) { ret 1; }

    # word args, so the record runs 8 bytes
    val first: res[Component, FontError] = read_component(p, 24, COMPONENTS_OFFSET);
    if (!sel first.ok) { ret 1; }
    var c: Component = first.ok;
    if (c.next != 18)                           { ret 1; }
    if (c.glyph != 724)                         { ret 1; }
    if ((c.flags & ARG_1_AND_2_ARE_WORDS) == 0) { ret 1; }
    if ((c.flags & MORE_COMPONENTS) == 0)       { ret 1; }
    if (c.m.dx != 807.0 || c.m.dy != 0.0)       { ret 1; }
    # an absent transform leaves the identity 2x2
    if (c.m.a != 1.0 || c.m.b != 0.0 || c.m.c != 0.0 || c.m.d != 1.0) { ret 1; }

    # byte args, so the record runs 6 bytes and ends the chain
    val second: res[Component, FontError] = read_component(p, 24, c.next);
    if (!sel second.ok) { ret 1; }
    c = second.ok;
    if (c.next != 24)                           { ret 1; }
    if (c.glyph != 79)                          { ret 1; }
    if ((c.flags & ARG_1_AND_2_ARE_WORDS) != 0) { ret 1; }
    if ((c.flags & MORE_COMPONENTS) != 0)       { ret 1; }
    if (c.m.dx != 11.0 || c.m.dy != 0.0)        { ret 1; }
    ret 0;
}

# no font on this system places a component with a scale, so the transform
# variants are exercised against records built here rather than lifted from one
var comp_buf: [32]u8;

# unwrap a decoded component, reporting a failed read as a record with next at 0
fun component_or_zero(r: res[Component, FontError]) Component {
    if (sel r.ok) { ret r.ok; }
    var zero: Component;
    ret zero;
}

# a component record: flags, glyph index, then two i16 args
fun build_component(flags: u16, glyph: u16, arg1: u16, arg2: u16) {
    val p: *u8 = ?comp_buf[0];
    w16(p, 0, flags | ARG_1_AND_2_ARE_WORDS);
    w16(p, 2, glyph);
    w16(p, 4, arg1);
    w16(p, 6, arg2);
}

test "glyf: component single scale" {
    build_component(ARGS_ARE_XY_VALUES | WE_HAVE_A_SCALE, 7, 30, 40);
    w16(?comp_buf[0], 8, 0x2000); # F2Dot14 0.5
    var c: Component = component_or_zero(read_component(?comp_buf[0], 32, 0));
    if (c.next != 10)                 { ret 1; }
    if (c.glyph != 7)                 { ret 1; }
    if (c.m.a != 0.5 || c.m.d != 0.5) { ret 1; }
    if (c.m.b != 0.0 || c.m.c != 0.0) { ret 1; }
    # the offset is in the composite's space by default, so the scale leaves it alone
    if (c.m.dx != 30.0 || c.m.dy != 40.0) { ret 1; }
    ret 0;
}

test "glyf: component x and y scale" {
    build_component(ARGS_ARE_XY_VALUES | WE_HAVE_AN_X_AND_Y_SCALE, 7, 0, 0);
    w16(?comp_buf[0], 8, 0x2000); # x scale 0.5
    w16(?comp_buf[0], 10, 0xC000); # y scale -1.0
    var c: Component = component_or_zero(read_component(?comp_buf[0], 32, 0));
    if (c.next != 12)                  { ret 1; }
    if (c.m.a != 0.5 || c.m.d != -1.0) { ret 1; }
    if (c.m.b != 0.0 || c.m.c != 0.0)  { ret 1; }
    ret 0;
}

test "glyf: component two by two" {
    build_component(ARGS_ARE_XY_VALUES | WE_HAVE_A_TWO_BY_TWO, 7, 0, 0);
    w16(?comp_buf[0], 8, 0x4000); # a = 1.0
    w16(?comp_buf[0], 10, 0x1000); # b = 0.25
    w16(?comp_buf[0], 12, 0xE000); # c = -0.5
    w16(?comp_buf[0], 14, 0x2000); # d = 0.5
    var c: Component = component_or_zero(read_component(?comp_buf[0], 32, 0));
    if (c.next != 16)                  { ret 1; }
    if (c.m.a != 1.0 || c.m.b != 0.25) { ret 1; }
    if (c.m.c != -0.5 || c.m.d != 0.5) { ret 1; }
    ret 0;
}

test "glyf: component byte args are signed offsets" {
    val p: *u8 = ?comp_buf[0];
    w16(p, 0, ARGS_ARE_XY_VALUES);
    w16(p, 2, 7);
    comp_buf[4] = 0xF6; # -10
    comp_buf[5] = 0x14; # +20
    var c: Component = component_or_zero(read_component(p, 32, 0));
    if (c.next != 6)                       { ret 1; }
    if (c.m.dx != -10.0 || c.m.dy != 20.0) { ret 1; }
    ret 0;
}

test "glyf: component point indices left unscaled" {
    # without ARGS_ARE_XY_VALUES the args are point indices, reported verbatim
    build_component(WE_HAVE_A_SCALE, 7, 12, 34);
    w16(?comp_buf[0], 8, 0x2000);
    var c: Component = component_or_zero(read_component(?comp_buf[0], 32, 0));
    if ((c.flags & ARGS_ARE_XY_VALUES) != 0) { ret 1; }
    if (c.m.dx != 12.0 || c.m.dy != 34.0)    { ret 1; }
    ret 0;
}

test "glyf: component scaled offset and grid rounding" {
    # a scaled offset passes through the 2x2, putting it on a half unit
    build_component(ARGS_ARE_XY_VALUES | WE_HAVE_A_SCALE | SCALED_COMPONENT_OFFSET, 7, 25, 0xFFF7);
    w16(?comp_buf[0], 8, 0x2000); # 0.5
    var c: Component = component_or_zero(read_component(?comp_buf[0], 32, 0));
    if (c.m.dx != 12.5 || c.m.dy != -4.5) { ret 1; }

    # ROUND_XY_TO_GRID snaps it to whole design units, halves away from zero
    build_component(ARGS_ARE_XY_VALUES | WE_HAVE_A_SCALE | SCALED_COMPONENT_OFFSET | ROUND_XY_TO_GRID, 7, 25, 0xFFF7);
    w16(?comp_buf[0], 8, 0x2000);
    c = component_or_zero(read_component(?comp_buf[0], 32, 0));
    if (c.m.dx != 13.0 || c.m.dy != -5.0) { ret 1; }

    # UNSCALED_COMPONENT_OFFSET wins over SCALED_COMPONENT_OFFSET
    build_component(ARGS_ARE_XY_VALUES | WE_HAVE_A_SCALE | SCALED_COMPONENT_OFFSET | UNSCALED_COMPONENT_OFFSET, 7, 25, 0xFFF7);
    w16(?comp_buf[0], 8, 0x2000);
    c = component_or_zero(read_component(?comp_buf[0], 32, 0));
    if (c.m.dx != 25.0 || c.m.dy != -9.0) { ret 1; }
    ret 0;
}

test "glyf: component record past the buffer rejected" {
    build_component(ARGS_ARE_XY_VALUES | WE_HAVE_A_TWO_BY_TWO, 7, 0, 0);
    # the record needs 16 bytes, and the 2x2 runs past a 12-byte buffer
    val r: res[Component, FontError] = read_component(?comp_buf[0], 12, 0);
    if (!sel r.err)            { ret 1; }
    if (!sel r.err.truncated)  { ret 2; }
    if (r.err.truncated != 12) { ret 3; }
    ret 0;
}

var xf_pts: [4]Point;

test "glyf: transform scales and translates points" {
    xf_pts[0] = Point{x: 0, y: 0, on_curve: true};
    xf_pts[1] = Point{x: 100, y: 0, on_curve: true};
    xf_pts[2] = Point{x: 100, y: 100, on_curve: true};
    xf_pts[3] = Point{x: 0, y: 100, on_curve: true};
    val m: Xform = Xform{a: 0.5, b: 0.0, c: 0.0, d: 0.5, dx: 100.0, dy: -50.0};
    xform_apply(?m, ?xf_pts[0], 4);
    if (xf_pts[0].x != 100 || xf_pts[0].y != -50) { ret 1; }
    if (xf_pts[1].x != 150 || xf_pts[1].y != -50) { ret 1; }
    if (xf_pts[2].x != 150 || xf_pts[2].y != 0)   { ret 1; }
    if (xf_pts[3].x != 100 || xf_pts[3].y != 0)   { ret 1; }
    ret 0;
}

test "glyf: identity leaves points alone" {
    xf_pts[0] = Point{x: -606, y: -141, on_curve: true};
    var m: Xform;
    xform_identity(?m);
    xform_apply(?m, ?xf_pts[0], 1);
    if (xf_pts[0].x != -606 || xf_pts[0].y != -141) { ret 1; }
    ret 0;
}

test "glyf: compose applies inner then outer" {
    # inner halves and shifts right, outer translates up
    val inner: Xform = Xform{a: 0.5, b: 0.0, c: 0.0, d: 0.5, dx: 40.0, dy: 0.0};
    val outer: Xform = Xform{a: 1.0, b: 0.0, c: 0.0, d: 1.0, dx: 0.0, dy: 10.0};
    var m:     Xform;
    xform_compose(?outer, ?inner, ?m);
    if (m.a != 0.5 || m.d != 0.5)     { ret 1; }
    if (m.dx != 40.0 || m.dy != 10.0) { ret 1; }

    xf_pts[0] = Point{x: 100, y: 100, on_curve: true};
    xform_apply(?m, ?xf_pts[0], 1);
    if (xf_pts[0].x != 90 || xf_pts[0].y != 60) { ret 1; }

    # the outer scale must reach the inner translation too
    val scale2: Xform = Xform{a: 2.0, b: 0.0, c: 0.0, d: 2.0, dx: 0.0, dy: 0.0};
    xform_compose(?scale2, ?inner, ?m);
    if (m.a != 1.0 || m.dx != 80.0) { ret 1; }
    ret 0;
}

test "glyf: transformed points saturate at the coordinate range" {
    xf_pts[0] = Point{x: 30000, y: -30000, on_curve: true};
    val m: Xform = Xform{a: 2.0, b: 0.0, c: 0.0, d: 2.0, dx: 0.0, dy: 0.0};
    xform_apply(?m, ?xf_pts[0], 1);
    if (xf_pts[0].x != 32767 || xf_pts[0].y != -32768) { ret 1; }
    ret 0;
}

var bd_pts: [5]Point;

test "glyf: outline bounds span every point, control points included" {
    bd_pts[0] = Point{x: 100, y: 100, on_curve: true};
    bd_pts[1] = Point{x: 300, y: 100, on_curve: true};
    bd_pts[2] = Point{x: 200, y: 400, on_curve: true};
    # a control point outside the on-curve hull still bounds the glyph
    bd_pts[3] = Point{x: -50, y: 250, on_curve: false};
    bd_pts[4] = Point{x: 120, y: -20, on_curve: true};
    val b: opt[Bounds] = outline_bounds(?bd_pts[0], 5);
    if (!sel b.some)                                { ret 1; }
    if (b.some.x_min != -50 || b.some.y_min != -20) { ret 2; }
    if (b.some.x_max != 300 || b.some.y_max != 400) { ret 3; }
    # a single point is its own box
    val one: opt[Bounds] = outline_bounds(?bd_pts[2], 1);
    if (!sel one.some)                                  { ret 4; }
    if (one.some.x_min != 200 || one.some.x_max != 200) { ret 5; }
    if (one.some.y_min != 400 || one.some.y_max != 400) { ret 6; }
    ret 0;
}

test "glyf: an empty outline has no bounds" {
    val b: opt[Bounds] = outline_bounds(?bd_pts[0], 0);
    if (!sel b.none) { ret 1; }
    ret 0;
}
