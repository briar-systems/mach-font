# the horizontal header table
#
# `hhea` carries the shared vertical metrics used for line layout (ascent,
# descent, line gap) and the count of long horizontal metrics in `hmtx`, which
# `font.hmtx` needs to resolve a glyph's advance. all reads are bounds-checked
# through font.read.

use font.error.FontError;
use font.read;
use std.types.result.res;
use std.types.size.usize;

# the horizontal header fields a layout engine and hmtx need
# ---
# ascent:            distance from baseline to the top of the design space
# descent:           distance from baseline to the bottom (typically negative)
# line_gap:          recommended additional spacing between lines
# advance_width_max: the widest advance in the font
# num_h_metrics:     count of long horizontal metrics in the hmtx table
pub rec Hhea {
    ascent:            i16;
    descent:           i16;
    line_gap:          i16;
    advance_width_max: u16;
    num_h_metrics:     u16;
}

# parse the hhea table at off
# ---
# data: pointer to the first byte of the file
# len:  number of bytes addressable through data
# off:  byte offset of the hhea table
# ret:  the parsed header, or truncated
pub fun parse_hhea(data: *u8, len: usize, off: usize) res[Hhea, FontError] {
    val ascent: res[i16, FontError] = read.read_i16(data, len, off + 4);
    if (sel ascent.err) { ret res[Hhea, FontError].err{ascent.err}; }
    val descent: res[i16, FontError] = read.read_i16(data, len, off + 6);
    if (sel descent.err) { ret res[Hhea, FontError].err{descent.err}; }
    val line_gap: res[i16, FontError] = read.read_i16(data, len, off + 8);
    if (sel line_gap.err) { ret res[Hhea, FontError].err{line_gap.err}; }
    val widest: res[u16, FontError] = read.read_u16(data, len, off + 10);
    if (sel widest.err) { ret res[Hhea, FontError].err{widest.err}; }
    val metrics: res[u16, FontError] = read.read_u16(data, len, off + 34);
    if (sel metrics.err) { ret res[Hhea, FontError].err{metrics.err}; }

    ret res[Hhea, FontError].ok{Hhea{
        ascent:            ascent.ok,
        descent:           descent.ok,
        line_gap:          line_gap.ok,
        advance_width_max: widest.ok,
        num_h_metrics:     metrics.ok,
    }};
}

fun w16(buf: *u8, off: usize, v: u16) {
    buf[off]     = (v >> 8)::u8;
    buf[off + 1] = (v & 0xFF)::u8;
}

var hhea_buf: [36]u8;

test "hhea: parse fields" {
    w16(?hhea_buf[0], 4, 0x0708); # ascent = 1800
    w16(?hhea_buf[0], 6, 0xFE0C); # descent = -500
    w16(?hhea_buf[0], 8, 90); # line_gap
    w16(?hhea_buf[0], 10, 2100); # advance_width_max
    w16(?hhea_buf[0], 34, 42); # num_h_metrics
    val r: res[Hhea, FontError] = parse_hhea(?hhea_buf[0], 36, 0);
    if (!sel r.ok)                      { ret 1; }
    if (r.ok.ascent != 1800)            { ret 2; }
    if (r.ok.descent != -500)           { ret 3; }
    if (r.ok.line_gap != 90)            { ret 4; }
    if (r.ok.advance_width_max != 2100) { ret 5; }
    if (r.ok.num_h_metrics != 42)       { ret 6; }
    ret 0;
}

test "hhea: truncated rejected" {
    val r: res[Hhea, FontError] = parse_hhea(?hhea_buf[0], 34, 0);
    if (!sel r.err)            { ret 1; }
    if (!sel r.err.truncated)  { ret 2; }
    if (r.err.truncated != 34) { ret 3; }
    ret 0;
}
