# the parsed-font facade
#
# `Font` is the prepared handle the rest of the api takes: it holds the file
# bytes, the located byte offsets of the tables a rasterizer needs, and the few
# global scalars (glyph count, units per em, loca format, long-metric count) that
# the table parsers require. `init` validates the sfnt header, locates the
# standard tables, and reads those scalars once. absent optional tables are
# recorded as offset 0, which never collides with a real table since the offset
# table occupies the first bytes of the file.

use font.read;
use font.table;
use font.head;
use font.maxp;
use font.hhea;
use font.hmtx;
use font.cmap;
use font.loca;
use font.glyf;
use font.kern;
use font.raster;
use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.size.usize;

# a prepared truetype font handle
# ---
# data:                pointer to the first byte of the font file
# len:                 number of bytes addressable through data
# head_off:            byte offset of the head table (0 if absent)
# maxp_off:            byte offset of the maxp table (0 if absent)
# hhea_off:            byte offset of the hhea table (0 if absent)
# hmtx_off:            byte offset of the hmtx table (0 if absent)
# loca_off:            byte offset of the loca table (0 if absent)
# glyf_off:            byte offset of the glyf table (0 if absent)
# cmap_off:            byte offset of the cmap table (0 if absent)
# cmap_sub:            byte offset of the selected cmap subtable (0 if none)
# kern_off:            byte offset of the kern table (0 if absent)
# kern_pairs:          byte offset of the selected kern pair array (0 if none)
# kern_num_pairs:      number of pairs in that array
# num_glyphs:          glyph count from maxp
# units_per_em:        design units per em from head
# index_to_loc_format: loca offset encoding from head (0 short, 1 long)
# num_h_metrics:       long horizontal metric count from hhea
# ascent:              baseline-to-top distance from hhea (0 if absent)
# descent:             baseline-to-bottom distance from hhea, typically negative
pub rec Font {
    data:                *u8;
    len:                 usize;
    head_off:            usize;
    maxp_off:            usize;
    hhea_off:            usize;
    hmtx_off:            usize;
    loca_off:            usize;
    glyf_off:            usize;
    cmap_off:            usize;
    cmap_sub:            usize;
    kern_off:            usize;
    kern_pairs:          usize;
    kern_num_pairs:      u16;
    num_glyphs:          u16;
    units_per_em:        u16;
    index_to_loc_format: i16;
    num_h_metrics:       u16;
    ascent:              i16;
    descent:             i16;
}

# locate a table and return its byte offset, or 0 when absent
fun locate(data: *u8, len: usize, a: u8, b: u8, c: u8, d: u8) usize {
    var t: table.Table;
    if (!table.find_table(data, len, a, b, c, d, ?t)) { ret 0; }
    ret t.offset::usize;
}

# prepare a font handle over an in-memory font file
#
# validates the sfnt version, locates the standard tables, and reads the global
# scalars from head, maxp, and hhea. head and maxp are required; hhea, hmtx, loca,
# glyf, and cmap are optional and recorded as offset 0 when absent. selecting a
# cmap subtable is deferred to font.cmap. reports failure on a non-truetype file,
# a missing head or maxp, or a malformed head.
# ---
# data: pointer to the first byte of the font file
# len:  number of bytes addressable through data
# out:  receives the prepared handle on success
# ret:  true when the font is a truetype file with a valid head and a maxp
pub fun init(data: *u8, len: usize, out: *Font) bool {
    if (!table.is_truetype(data, len)) { ret false; }

    var f: Font;
    f.data = data;
    f.len  = len;

    f.head_off = locate(data, len, 'h', 'e', 'a', 'd');
    f.maxp_off = locate(data, len, 'm', 'a', 'x', 'p');
    f.hhea_off = locate(data, len, 'h', 'h', 'e', 'a');
    f.hmtx_off = locate(data, len, 'h', 'm', 't', 'x');
    f.loca_off = locate(data, len, 'l', 'o', 'c', 'a');
    f.glyf_off = locate(data, len, 'g', 'l', 'y', 'f');
    f.cmap_off = locate(data, len, 'c', 'm', 'a', 'p');
    f.cmap_sub = 0;
    f.kern_off = locate(data, len, 'k', 'e', 'r', 'n');
    f.kern_pairs     = 0;
    f.kern_num_pairs = 0;

    if (f.head_off == 0) { ret false; }
    if (f.maxp_off == 0) { ret false; }

    var h: head.Head;
    if (!head.parse_head(data, len, f.head_off, ?h)) { ret false; }
    f.units_per_em        = h.units_per_em;
    f.index_to_loc_format = h.index_to_loc_format;

    if (!maxp.num_glyphs(data, len, f.maxp_off, ?f.num_glyphs)) { ret false; }

    f.num_h_metrics = 0;
    f.ascent        = 0;
    f.descent       = 0;
    if (f.hhea_off != 0) {
        var hh: hhea.Hhea;
        if (!hhea.parse_hhea(data, len, f.hhea_off, ?hh)) { ret false; }
        f.num_h_metrics = hh.num_h_metrics;
        f.ascent        = hh.ascent;
        f.descent       = hh.descent;
    }

    # an unusable or absent cmap leaves cmap_sub at 0; character mapping is then
    # unavailable but the font is still valid for index-addressed glyph access.
    if (f.cmap_off != 0) {
        var sub: usize = 0;
        if (cmap.select_subtable(data, len, f.cmap_off, ?sub)) {
            f.cmap_sub = sub;
        }
    }

    # kerning is optional in the same way: most fonts carry none, and one whose
    # kern table holds no horizontal format-0 subtable simply kerns nothing.
    if (f.kern_off != 0) {
        var pairs: usize = 0;
        var n:     u16   = 0;
        if (kern.select_subtable(data, len, f.kern_off, ?pairs, ?n)) {
            f.kern_pairs     = pairs;
            f.kern_num_pairs = n;
        }
    }

    out[0] = f;
    ret true;
}

# read a glyph's advance width and left-side bearing
#
# a convenience over font.hmtx using the handle's cached hmtx offset and metric
# counts. reports failure when the font has no hmtx table or the glyph is out of
# range.
# ---
# f:           prepared font handle
# glyph:       glyph index to resolve
# out_advance: receives the advance width in font units
# out_lsb:     receives the left-side bearing in font units
# ret:         true on success, false when hmtx is absent or the glyph is invalid
pub fun glyph_hmetrics(f: *Font, glyph: u16, out_advance: *u16, out_lsb: *i16) bool {
    if (f.hmtx_off == 0) { ret false; }
    ret hmtx.metrics(f.data, f.len, f.hmtx_off, f.num_h_metrics, f.num_glyphs, glyph, out_advance, out_lsb);
}

# read the kerning correction applied between two adjacent glyphs
#
# a convenience over font.kern using the handle's selected pair array. the value
# adds to the left glyph's advance width, so a negative value tucks the pair
# closer together. a pair the font does not kern yields 0. reports failure when
# the font carries no usable horizontal format-0 kern subtable, which is how a
# caller distinguishes "this font does not kern" from "this pair is unkerned".
# ---
# f:     prepared font handle
# left:  glyph index of the left-hand glyph
# right: glyph index of the right-hand glyph
# out:   receives the correction in font units, 0 when the pair is unkerned
# ret:   true on a completed lookup, false when the font has no kerning
pub fun glyph_kern_advance(f: *Font, left: u16, right: u16, out: *i16) bool {
    if (f.kern_pairs == 0) { ret false; }
    ret kern.lookup(f.data, f.len, f.kern_pairs, f.kern_num_pairs, left, right, out);
}

# map a unicode codepoint to a glyph index through the selected cmap subtable
#
# a convenience over font.cmap using the handle's selected subtable. an unmapped
# codepoint yields glyph 0. reports failure when the font has no usable cmap
# subtable or the subtable is malformed.
# ---
# f:         prepared font handle
# codepoint: the unicode codepoint to map
# out:       receives the glyph index (0 when unmapped) on success
# ret:       true on a successful lookup, false when no cmap is available
pub fun glyph_index(f: *Font, codepoint: u32, out: *u16) bool {
    if (f.cmap_sub == 0) { ret false; }
    ret cmap.lookup(f.data, f.len, f.cmap_sub, codepoint, out);
}

# how deeply composite glyphs may nest before a reference chain is rejected
#
# real fonts nest a level or two — an accented letter built from a letter and a
# mark, occasionally over an already-accented letter. a chain longer than this is
# either malformed or cyclic, and the cap is what turns a self-referencing glyph
# into a clean rejection instead of unbounded recursion.
val MAX_COMPOSITE_DEPTH: usize = 5;

# append one glyph's outline to the buffers under an accumulated transform
#
# a simple glyph extracts straight into the free tail of the buffers, has the
# transform applied, and has its contour ends biased past the points already
# written. a composite glyph instead walks its component records, composing each
# component's placement onto the running transform and recursing.
fun compose(f: *Font, glyph: u16, m: *glyf.Xform, depth: usize, pts: *glyf.Point, pts_cap: usize, ends: *u16, ends_cap: usize, io: *glyf.Outline) bool {
    if (depth > MAX_COMPOSITE_DEPTH) { ret false; }
    if (glyph >= f.num_glyphs) { ret false; }

    var start: u32 = 0;
    var end:   u32 = 0;
    if (!loca.glyph_range(f.data, f.len, f.loca_off, f.index_to_loc_format, glyph, ?start, ?end)) { ret false; }
    # an empty glyph contributes nothing, whether it is the whole request or a component.
    if (start == end) { ret true; }

    val goff: usize = f.glyf_off + start::usize;
    var info: glyf.GlyphInfo;
    if (!glyf.glyph_header(f.data, f.len, goff, ?info)) { ret false; }

    if (!glyf.is_composite(?info)) {
        val base_pts:  usize = io.num_points::usize;
        val base_ends: usize = io.num_contours::usize;
        if (base_pts > pts_cap || base_ends > ends_cap) { ret false; }

        var sub: glyf.Outline;
        if (!glyf.extract_simple(f.data, f.len, goff, ?pts[base_pts], pts_cap - base_pts, ?ends[base_ends], ends_cap - base_ends, ?sub)) { ret false; }
        if (base_pts + sub.num_points::usize > 0xFFFF) { ret false; }

        glyf.xform_apply(m, ?pts[base_pts], sub.num_points::usize);

        var i: usize = 0;
        for (i < sub.num_contours::usize) {
            ends[base_ends + i] = ends[base_ends + i] + base_pts::u16;
            i = i + 1;
        }

        io.num_points   = io.num_points + sub.num_points;
        io.num_contours = io.num_contours + sub.num_contours;
        ret true;
    }

    var off: usize = goff + glyf.COMPONENTS_OFFSET;
    var more: bool = true;
    for (more) {
        var c: glyf.Component;
        var next: usize = 0;
        if (!glyf.read_component(f.data, f.len, off, ?c, ?next)) { ret false; }
        # point-matched placement aligns a component by point index rather than an
        # offset; it is not resolved here, so such a glyph is rejected outright.
        if ((c.flags & glyf.ARGS_ARE_XY_VALUES) == 0) { ret false; }

        var child: glyf.Xform;
        glyf.xform_compose(m, ?c.m, ?child);
        if (!compose(f, c.glyph, ?child, depth + 1, pts, pts_cap, ends, ends_cap, io)) { ret false; }

        more = (c.flags & glyf.MORE_COMPONENTS) != 0;
        off  = next;
    }
    ret true;
}

# extract a glyph's outline into caller-provided buffers
#
# resolves the glyph's data range through loca and extracts its contours through
# glyf. a composite glyph is resolved recursively: each component's outline is
# appended under the component's transform, so the result is one flat point and
# contour list a rasterizer consumes exactly like a simple glyph's. an empty glyph
# (no outline, e.g. a space) succeeds with zero counts. reports failure when loca
# or glyf is absent, the glyph is out of range, a buffer is too small, or a
# composite nests past MAX_COMPOSITE_DEPTH — which is how a cyclic reference is
# caught. sizing the buffers from maxp's storage maxima admits every glyph in the
# font.
# ---
# f:        prepared font handle
# glyph:    glyph index to extract
# pts:      buffer receiving the extracted points
# pts_cap:  capacity of pts in points
# ends:     buffer receiving each contour's end point index
# ends_cap: capacity of ends in entries
# out:      receives the written contour and point counts
# ret:      true on a fully extracted (possibly empty) glyph, false otherwise
pub fun glyph_outline(f: *Font, glyph: u16, pts: *glyf.Point, pts_cap: usize, ends: *u16, ends_cap: usize, out: *glyf.Outline) bool {
    if (f.loca_off == 0 || f.glyf_off == 0) { ret false; }
    if (glyph >= f.num_glyphs) { ret false; }

    var m: glyf.Xform;
    glyf.xform_identity(?m);
    out[0] = glyf.Outline{ num_contours: 0, num_points: 0 };
    ret compose(f, glyph, ?m, 0, pts, pts_cap, ends, ends_cap, out);
}

# read the point and contour bounds that size outline buffers for this font
#
# a convenience over font.maxp: buffers sized to the larger of the simple and
# composite maxima admit glyph_outline for any glyph in the font. reports failure
# when the font's maxp is the 0.5 version, which declares no maxima.
# ---
# f:   prepared font handle
# out: receives the maxima on success
# ret: true when the font declares storage maxima, false otherwise
pub fun outline_maxima(f: *Font, out: *maxp.Maxima) bool {
    ret maxp.storage_maxima(f.data, f.len, f.maxp_off, out);
}

# compute the scale that maps the font's design space to a target pixel height
#
# the height spans the font's ascent-to-descent range. This differs from an em
# size whenever the face extends above or below its em square. Returns 0 when
# the font lacks usable vertical metrics (an absent hhea).
# ---
# f:      prepared font handle
# pixels: desired ascent-to-descent height in pixels
# ret:    design-unit-to-pixel scale, or 0 when vertical metrics are unavailable
pub fun scale_for_pixel_height(f: *Font, pixels: f32) f32 {
    val span: i32 = f.ascent::i32 - f.descent::i32;
    if (span <= 0) { ret 0.0; }
    ret pixels / span::f32;
}

# compute the scale that maps one em to a target pixel size
#
# Font APIs conventionally name a face by this size. A font designed on a pixel
# grid needs it specifically: an 11-pixel em over 550 design units maps every
# 50-unit cell to exactly one pixel even when ascenders and descenders extend
# beyond the em square.
# ---
# f:      prepared font handle
# pixels: desired em size in pixels
# ret:    design-unit-to-pixel scale, or 0 when units-per-em is absent
pub fun scale_for_em_size(f: *Font, pixels: f32) f32 {
    if (f.units_per_em == 0) { ret 0.0; }
    ret pixels / f.units_per_em::f32;
}

# render a glyph into an 8-bit coverage bitmap at the given scale
#
# extracts the glyph outline, flattens its curves, and fills the bitmap with the
# glyph placed against its own bounding box: the glyph's lower-left corner maps to
# the bitmap's lower-left. every pixel is written, so the bitmap need not be
# pre-cleared. an empty glyph clears the bitmap to zero. a composite glyph renders
# like any other: its components are composed into one outline first. the caller
# sizes the points, contour-ends, and edges scratch buffers. reports failure when
# loca or glyf is absent, the glyph is out of range, or a scratch buffer is too
# small.
# ---
# f:         prepared font handle
# glyph:     glyph index to render
# scale:     design-unit-to-pixel scale, e.g. from scale_for_pixel_height
# pts:       scratch buffer for extracted points
# pts_cap:   capacity of pts
# ends:      scratch buffer for contour end indices
# ends_cap:  capacity of ends
# edges:     scratch buffer for flattened edges
# edges_cap: capacity of edges
# bitmap:    row-major width*height output buffer
# width:     bitmap width in pixels
# height:    bitmap height in pixels
# ret:       true on a fully rendered (possibly empty) glyph, false otherwise
pub fun render_glyph(f: *Font, glyph: u16, scale: f32, pts: *glyf.Point, pts_cap: usize, ends: *u16, ends_cap: usize, edges: *raster.Edge, edges_cap: usize, bitmap: *u8, width: u16, height: u16) bool {
    var o: glyf.Outline;
    if (!glyph_outline(f, glyph, pts, pts_cap, ends, ends_cap, ?o)) { ret false; }

    if (o.num_points == 0) {
        clear_bitmap(bitmap, width, height);
        ret true;
    }

    # place the glyph against its bounding box so its lower-left maps to the origin.
    var info: glyf.GlyphInfo;
    if (!glyph_header_of(f, glyph, ?info)) { ret false; }
    val x_off: f32 = -(info.x_min::f32) * scale;
    val y_off: f32 = -(info.y_min::f32) * scale;

    var count: usize = 0;
    if (!raster.flatten(pts, o.num_points, ends, o.num_contours, scale, x_off, y_off, height, edges, edges_cap, ?count)) { ret false; }
    raster.fill(edges, count, bitmap, width, height);
    ret true;
}

# read a glyph's header through the handle's loca and glyf tables
fun glyph_header_of(f: *Font, glyph: u16, out: *glyf.GlyphInfo) bool {
    var start: u32 = 0;
    var end:   u32 = 0;
    if (!loca.glyph_range(f.data, f.len, f.loca_off, f.index_to_loc_format, glyph, ?start, ?end)) { ret false; }
    ret glyf.glyph_header(f.data, f.len, f.glyf_off + start::usize, out);
}

# write zero coverage across the whole bitmap
fun clear_bitmap(bitmap: *u8, width: u16, height: u16) {
    val n: usize = width::usize * height::usize;
    var i: usize = 0;
    for (i < n) {
        bitmap[i] = 0;
        i = i + 1;
    }
}

fun w16(buf: *u8, off: usize, v: u16) {
    buf[off]     = (v >> 8)::u8;
    buf[off + 1] = (v & 0xFF)::u8;
}

fun w32(buf: *u8, off: usize, v: u32) {
    buf[off]     = (v >> 24)::u8;
    buf[off + 1] = ((v >> 16) & 0xFF)::u8;
    buf[off + 2] = ((v >> 8) & 0xFF)::u8;
    buf[off + 3] = (v & 0xFF)::u8;
}

fun tag(buf: *u8, off: usize, a: u8, b: u8, c: u8, d: u8) {
    buf[off]     = a;
    buf[off + 1] = b;
    buf[off + 2] = c;
    buf[off + 3] = d;
}

# a complete minimal font: head, maxp, hhea, hmtx, cmap, loca, glyf. two glyphs
# (0 empty, 1 a triangle); the cmap maps 'A' to glyph 1. tables built by hand,
# mirroring the parsers in reverse.
var font_buf: [320]u8;

fun build_font() {
    val p: *u8 = ?font_buf[0];

    w32(p, 0, 0x00010000);   # sfnt version
    w16(p, 4, 7);            # numTables
    w16(p, 6, 0);
    w16(p, 8, 0);
    w16(p, 10, 0);

    # directory entries: tag, checksum (0), offset, length
    tag(p, 12,  'c', 'm', 'a', 'p'); w32(p, 20,  228); w32(p, 24,  44);
    tag(p, 28,  'g', 'l', 'y', 'f'); w32(p, 36,  278); w32(p, 40,  24);
    tag(p, 44,  'h', 'e', 'a', 'd'); w32(p, 52,  124); w32(p, 56,  54);
    tag(p, 60,  'h', 'h', 'e', 'a'); w32(p, 68,  184); w32(p, 72,  36);
    tag(p, 76,  'h', 'm', 't', 'x'); w32(p, 84,  220); w32(p, 88,  8);
    tag(p, 92,  'l', 'o', 'c', 'a'); w32(p, 100, 272); w32(p, 104, 6);
    tag(p, 108, 'm', 'a', 'x', 'p'); w32(p, 116, 178); w32(p, 120, 6);

    # head @124
    font_buf[124 + 12] = 0x5F;
    font_buf[124 + 13] = 0x0F;
    font_buf[124 + 14] = 0x3C;
    font_buf[124 + 15] = 0xF5;
    w16(p, 124 + 18, 1000);      # units_per_em
    w16(p, 124 + 50, 0);         # index_to_loc_format = short

    # maxp @178
    w32(p, 178, 0x00010000);
    w16(p, 178 + 4, 2);          # numGlyphs

    # hhea @184
    w16(p, 184 + 4, 800);        # ascent
    w16(p, 184 + 6, 0xFF38);     # descent = -200
    w16(p, 184 + 34, 2);         # num_h_metrics

    # hmtx @220: 2 long metrics
    w16(p, 220 + 0, 500);        # glyph 0 advance
    w16(p, 220 + 2, 0);          # glyph 0 lsb
    w16(p, 220 + 4, 650);        # glyph 1 advance
    w16(p, 220 + 6, 40);         # glyph 1 lsb

    # cmap @228
    w16(p, 228 + 0, 0);          # version
    w16(p, 228 + 2, 1);          # numTables
    w16(p, 228 + 4, 3);          # platformID = windows
    w16(p, 228 + 6, 1);          # encodingID = BMP unicode
    w32(p, 228 + 8, 12);         # subtable offset (relative to cmap)
    # format 4 subtable @240: 'A' -> glyph 1
    w16(p, 240 + 0, 4);          # format
    w16(p, 240 + 2, 32);         # length
    w16(p, 240 + 4, 0);          # language
    w16(p, 240 + 6, 4);          # segCountX2 (2 segments)
    w16(p, 254, 0x41);           # endCode[0]
    w16(p, 256, 0xFFFF);         # endCode[1]
    w16(p, 258, 0);              # reservedPad
    w16(p, 260, 0x41);           # startCode[0]
    w16(p, 262, 0xFFFF);         # startCode[1]
    w16(p, 264, 0xFFC0);         # idDelta[0] = -64: 'A'(0x41) -> 1
    w16(p, 266, 1);              # idDelta[1]
    w16(p, 268, 0);              # idRangeOffset[0]
    w16(p, 270, 0);              # idRangeOffset[1]

    # loca @272: short offsets (halved). glyph 0 empty, glyph 1 = [0, 24)
    w16(p, 272, 0);
    w16(p, 274, 0);
    w16(p, 276, 12);

    # glyf @278: glyph 1 is a triangle (100,100), (300,100), (200,400)
    w16(p, 278, 1);              # numberOfContours
    w16(p, 280, 100);            # xMin
    w16(p, 282, 100);            # yMin
    w16(p, 284, 300);            # xMax
    w16(p, 286, 400);            # yMax
    w16(p, 288, 2);              # endPtsOfContours[0]
    w16(p, 290, 0);              # instructionLength
    font_buf[292] = 0x37;        # p0: on, x short +, y short +
    font_buf[293] = 0x33;        # p1: on, x short +, y same
    font_buf[294] = 0x03;        # p2: on, x short -, y i16
    font_buf[295] = 100;         # p0 x = +100
    font_buf[296] = 200;         # p1 x = +200
    font_buf[297] = 100;         # p2 x = -100
    font_buf[298] = 100;         # p0 y = +100
    w16(p, 299, 300);            # p2 y = +300 (i16)
}

var e2e_pts: [8]glyf.Point;
var e2e_ends: [4]u16;
var e2e_edges: [64]raster.Edge;
var e2e_bmp: [64]u8;

test "info: init locates every table and reads globals" {
    build_font();
    var f: Font;
    if (!init(?font_buf[0], 320, ?f)) { ret 1; }
    if (f.units_per_em != 1000) { ret 1; }
    if (f.index_to_loc_format != 0) { ret 1; }
    if (f.num_glyphs != 2) { ret 1; }
    if (f.num_h_metrics != 2) { ret 1; }
    if (f.ascent != 800 || f.descent != -200) { ret 1; }
    if (f.glyf_off != 278 || f.loca_off != 272) { ret 1; }
    if (f.cmap_sub != 240) { ret 1; }
    ret 0;
}

test "info: em sizing is independent of the line metrics" {
    var f: Font;
    f.units_per_em = 550;
    f.ascent = 550;
    f.descent = 0 - 150;
    if (scale_for_em_size(?f, 11.0) != 0.02) { ret 1; }
    if (scale_for_pixel_height(?f, 11.0) == 0.02) { ret 2; }
    f.units_per_em = 0;
    if (scale_for_em_size(?f, 11.0) != 0.0) { ret 3; }
    ret 0;
}

test "info: cmap maps 'A' to glyph 1" {
    build_font();
    var f: Font;
    if (!init(?font_buf[0], 320, ?f)) { ret 1; }
    var g: u16 = 0;
    if (!glyph_index(?f, 0x41, ?g)) { ret 1; }
    if (g != 1) { ret 1; }
    # an unmapped codepoint resolves to glyph 0
    if (!glyph_index(?f, 0x42, ?g)) { ret 1; }
    if (g != 0) { ret 1; }
    ret 0;
}

test "info: glyph_hmetrics via facade" {
    build_font();
    var f: Font;
    if (!init(?font_buf[0], 320, ?f)) { ret 1; }
    var adv: u16 = 0;
    var lsb: i16 = 0;
    if (!glyph_hmetrics(?f, 1, ?adv, ?lsb)) { ret 1; }
    if (adv != 650 || lsb != 40) { ret 1; }
    ret 0;
}

test "info: outline extraction end to end" {
    build_font();
    var f: Font;
    if (!init(?font_buf[0], 320, ?f)) { ret 1; }
    var o: glyf.Outline;
    if (!glyph_outline(?f, 1, ?e2e_pts[0], 8, ?e2e_ends[0], 4, ?o)) { ret 1; }
    if (o.num_contours != 1 || o.num_points != 3) { ret 1; }
    if (e2e_pts[0].x != 100 || e2e_pts[0].y != 100) { ret 1; }
    if (e2e_pts[1].x != 300 || e2e_pts[1].y != 100) { ret 1; }
    if (e2e_pts[2].x != 200 || e2e_pts[2].y != 400) { ret 1; }
    # glyph 0 is empty
    if (!glyph_outline(?f, 0, ?e2e_pts[0], 8, ?e2e_ends[0], 4, ?o)) { ret 1; }
    if (o.num_contours != 0 || o.num_points != 0) { ret 1; }
    ret 0;
}

test "info: render glyph covers interior, leaves corner empty" {
    build_font();
    var f: Font;
    if (!init(?font_buf[0], 320, ?f)) { ret 1; }
    if (!render_glyph(?f, 1, 0.02, ?e2e_pts[0], 8, ?e2e_ends[0], 4, ?e2e_edges[0], 64, ?e2e_bmp[0], 8, 8)) { ret 1; }
    # the triangle centroid maps near pixel (2, 6)
    if (e2e_bmp[6 * 8 + 2] == 0) { ret 1; }
    # a far corner stays empty
    if (e2e_bmp[7] != 0) { ret 1; }
    ret 0;
}

test "info: non-truetype rejected" {
    build_font();
    w32(?font_buf[0], 0, 0x4F54544F);   # OTTO
    var f: Font;
    if (init(?font_buf[0], 320, ?f)) { ret 1; }
    ret 0;
}

test "info: truncated font rejected" {
    build_font();
    var f: Font;
    # the directory claims 7 tables but only a few bytes are present
    if (init(?font_buf[0], 20, ?f)) { ret 1; }
    ret 0;
}

# a second font carrying dejavu sans' composite geometry: the glyphs, component
# offsets, kerning values and metrics below are that font's real numbers at its
# 2048 units per em, cross-checked against an independent resolution of the same
# outlines. only the glyph indices are renumbered, so six glyphs stand in for
# dejavu's several thousand:
#
#   1  dotbelowcomb    simple, one rectangular contour
#   2  l               simple, one rectangular contour
#   3  uni1E37         composite: dotbelowcomb at x+807, l at x+11
#   4  macron          simple, one rectangular contour
#   5  uni1E39         composite: macron at (-216, +315), uni1E37 at the origin
#
# glyph 5 nests a composite inside a composite, which is what exercises the
# recursive walk past one level.
var dv_buf: [512]u8;

# byte offset of the first composite glyph within dv_buf
val DV_G3: usize = 376;

# write a one-contour rectangle glyph: 34 bytes, all points on-curve, every
# coordinate an i16 delta
fun rect_glyph(p: *u8, at: usize, x0: i16, y0: i16, x1: i16, y1: i16) {
    w16(p, at, 1);
    w16(p, at + 2, x0:~u16);
    w16(p, at + 4, y0:~u16);
    w16(p, at + 6, x1:~u16);
    w16(p, at + 8, y1:~u16);
    w16(p, at + 10, 3);            # endPtsOfContours[0]
    w16(p, at + 12, 0);            # instructionLength
    p[at + 14] = 0x01;             # every point on-curve with i16 deltas
    p[at + 15] = 0x01;
    p[at + 16] = 0x01;
    p[at + 17] = 0x01;
    w16(p, at + 18, x0:~u16);      # x deltas, walking the rectangle
    w16(p, at + 20, (x1 - x0):~u16);
    w16(p, at + 22, 0);
    w16(p, at + 24, (x0 - x1):~u16);
    w16(p, at + 26, y1:~u16);      # y deltas
    w16(p, at + 28, 0);
    w16(p, at + 30, (y0 - y1):~u16);
    w16(p, at + 32, 0);
}

fun build_dejavu() {
    val p: *u8 = ?dv_buf[0];

    w32(p, 0, 0x00010000);
    w16(p, 4, 7);            # numTables

    tag(p, 12,  'g', 'l', 'y', 'f'); w32(p, 20,  308); w32(p, 24,  150);
    tag(p, 28,  'h', 'e', 'a', 'd'); w32(p, 36,  124); w32(p, 40,  54);
    tag(p, 44,  'h', 'h', 'e', 'a'); w32(p, 52,  192); w32(p, 56,  36);
    tag(p, 60,  'h', 'm', 't', 'x'); w32(p, 68,  228); w32(p, 72,  24);
    tag(p, 76,  'k', 'e', 'r', 'n'); w32(p, 84,  266); w32(p, 88,  42);
    tag(p, 92,  'l', 'o', 'c', 'a'); w32(p, 100, 252); w32(p, 104, 14);
    tag(p, 108, 'm', 'a', 'x', 'p'); w32(p, 116, 178); w32(p, 120, 14);

    # head @124
    dv_buf[124 + 12] = 0x5F;
    dv_buf[124 + 13] = 0x0F;
    dv_buf[124 + 14] = 0x3C;
    dv_buf[124 + 15] = 0xF5;
    w16(p, 124 + 18, 2048);      # units_per_em
    w16(p, 124 + 50, 0);         # index_to_loc_format = short

    # maxp @178
    w32(p, 178, 0x00010000);
    w16(p, 178 + 4, 6);          # numGlyphs
    w16(p, 178 + 6, 4);          # maxPoints
    w16(p, 178 + 8, 1);          # maxContours
    w16(p, 178 + 10, 12);        # maxCompositePoints
    w16(p, 178 + 12, 3);         # maxCompositeContours

    # hhea @192
    w16(p, 192 + 4, 1901);       # ascent
    w16(p, 192 + 6, 0xFE1D);     # descent = -483
    w16(p, 192 + 34, 6);         # num_h_metrics

    # hmtx @228: only glyph 3 carries dejavu's own advance and bearing
    w16(p, 228 + 0, 1024); w16(p, 228 + 2, 0);
    w16(p, 228 + 4, 0);    w16(p, 228 + 6, 0xFDA2);
    w16(p, 228 + 8, 569);  w16(p, 228 + 10, 193);
    w16(p, 228 + 12, 589); w16(p, 228 + 14, 201);
    w16(p, 228 + 16, 1024); w16(p, 228 + 18, 213);
    w16(p, 228 + 20, 589); w16(p, 228 + 22, 0xFFFD);

    # loca @252: short offsets, halved. glyph 0 is empty
    w16(p, 252, 0);
    w16(p, 254, 0);
    w16(p, 256, 17);     # 34
    w16(p, 258, 34);     # 68
    w16(p, 260, 46);     # 92
    w16(p, 262, 63);     # 126
    w16(p, 264, 75);     # 150

    # kern @266: one horizontal format-0 subtable of four real dejavu pairs
    w16(p, 266, 0);          # version
    w16(p, 268, 1);          # nTables
    w16(p, 270, 0);          # subtable version
    w16(p, 272, 38);         # subtable length
    w16(p, 274, 0x0001);     # coverage: format 0, horizontal
    w16(p, 276, 4);          # nPairs
    w16(p, 278, 24);         # searchRange
    w16(p, 280, 2);          # entrySelector
    w16(p, 282, 0);          # rangeShift
    w16(p, 284, 16);  w16(p, 286, 36);  w16(p, 288, 0xFFD3);   # hyphen, A: -45
    w16(p, 290, 134); w16(p, 292, 90);  w16(p, 294, 0xFFAD);   # Adieresis, w: -83
    w16(p, 296, 134); w16(p, 298, 92);  w16(p, 300, 0xFF75);   # Adieresis, y: -139
    w16(p, 302, 134); w16(p, 304, 109); w16(p, 306, 0xFFB7);   # Adieresis, guillemotleft: -73

    # glyf @308
    rect_glyph(p, 308, -606, -375, -422, -141);   # glyph 1: dotbelowcomb
    rect_glyph(p, 342, 193, 0, 377, 1556);        # glyph 2: l
    rect_glyph(p, 400, 213, 1378, 811, 1526);     # glyph 4: macron

    # glyph 3 @376: composite of dotbelowcomb and l
    w16(p, 376, 0xFFFF);     # numberOfContours = -1
    w16(p, 378, 201);        # xMin
    w16(p, 380, 0xFE89);     # yMin = -375
    w16(p, 382, 388);        # xMax
    w16(p, 384, 1556);       # yMax
    w16(p, 386, 0x1027);     # words, xy values, round to grid, more, unscaled offset
    w16(p, 388, 1);          # component glyph
    w16(p, 390, 807);        # x offset
    w16(p, 392, 0);          # y offset
    w16(p, 394, 0x1006);     # bytes, xy values, round to grid, unscaled offset
    w16(p, 396, 2);          # component glyph
    dv_buf[398] = 11;        # x offset
    dv_buf[399] = 0;         # y offset

    # glyph 5 @434: composite of macron and the composite glyph 3
    w16(p, 434, 0xFFFF);
    w16(p, 436, 0xFFFD);     # xMin = -3
    w16(p, 438, 0xFE89);     # yMin = -375
    w16(p, 440, 595);        # xMax
    w16(p, 442, 1841);       # yMax
    w16(p, 444, 0x1027);
    w16(p, 446, 4);          # component glyph: macron
    w16(p, 448, 0xFF28);     # x offset = -216
    w16(p, 450, 315);        # y offset
    w16(p, 452, 0x1006);
    w16(p, 454, 3);          # component glyph: the composite
    dv_buf[456] = 0;
    dv_buf[457] = 0;
}

var dv_pts: [16]glyf.Point;
var dv_ends: [4]u16;
var dv_edges: [128]raster.Edge;
var dv_bmp: [80]u8;

test "info: composite outline composes its components" {
    build_dejavu();
    var f: Font;
    if (!init(?dv_buf[0], 512, ?f)) { ret 1; }
    if (f.units_per_em != 2048) { ret 1; }

    var o: glyf.Outline;
    if (!glyph_outline(?f, 3, ?dv_pts[0], 16, ?dv_ends[0], 4, ?o)) { ret 1; }
    if (o.num_contours != 2 || o.num_points != 8) { ret 1; }
    # each component's contour ends past the points already written
    if (dv_ends[0] != 3 || dv_ends[1] != 7) { ret 1; }

    # dotbelowcomb shifted right by 807
    if (dv_pts[0].x != 201 || dv_pts[0].y != -141) { ret 1; }
    if (dv_pts[1].x != 385 || dv_pts[1].y != -141) { ret 1; }
    if (dv_pts[2].x != 385 || dv_pts[2].y != -375) { ret 1; }
    if (dv_pts[3].x != 201 || dv_pts[3].y != -375) { ret 1; }
    # l shifted right by 11
    if (dv_pts[4].x != 204 || dv_pts[4].y != 1556) { ret 1; }
    if (dv_pts[5].x != 388 || dv_pts[5].y != 1556) { ret 1; }
    if (dv_pts[6].x != 388 || dv_pts[6].y != 0) { ret 1; }
    if (dv_pts[7].x != 204 || dv_pts[7].y != 0) { ret 1; }

    var adv: u16 = 0;
    var lsb: i16 = 0;
    if (!glyph_hmetrics(?f, 3, ?adv, ?lsb)) { ret 1; }
    if (adv != 589 || lsb != 201) { ret 1; }
    ret 0;
}

test "info: nested composite resolves both levels" {
    build_dejavu();
    var f: Font;
    if (!init(?dv_buf[0], 512, ?f)) { ret 1; }

    var o: glyf.Outline;
    if (!glyph_outline(?f, 5, ?dv_pts[0], 16, ?dv_ends[0], 4, ?o)) { ret 1; }
    if (o.num_contours != 3 || o.num_points != 12) { ret 1; }
    if (dv_ends[0] != 3 || dv_ends[1] != 7 || dv_ends[2] != 11) { ret 1; }

    # macron shifted by (-216, +315)
    if (dv_pts[0].x != -3 || dv_pts[0].y != 1841) { ret 1; }
    if (dv_pts[1].x != 595 || dv_pts[1].y != 1841) { ret 1; }
    if (dv_pts[2].x != 595 || dv_pts[2].y != 1693) { ret 1; }
    if (dv_pts[3].x != -3 || dv_pts[3].y != 1693) { ret 1; }
    # the nested composite lands where it does on its own, placed at the origin
    if (dv_pts[4].x != 201 || dv_pts[4].y != -141) { ret 1; }
    if (dv_pts[8].x != 204 || dv_pts[8].y != 1556) { ret 1; }
    if (dv_pts[11].x != 204 || dv_pts[11].y != 0) { ret 1; }
    ret 0;
}

test "info: composite renders both components" {
    build_dejavu();
    var f: Font;
    if (!init(?dv_buf[0], 512, ?f)) { ret 1; }
    # 1931 design units of height across 20 rows; the glyph is under 2 px wide
    if (!render_glyph(?f, 3, 0.01035, ?dv_pts[0], 16, ?dv_ends[0], 4, ?dv_edges[0], 128, ?dv_bmp[0], 4, 20)) { ret 1; }
    # the stem runs down the upper rows and the dot sits at the bottom
    if (dv_bmp[5 * 4 + 1] == 0) { ret 1; }
    if (dv_bmp[18 * 4 + 1] == 0) { ret 1; }
    # the gap between them is what proves the two components stayed apart
    if (dv_bmp[16 * 4 + 1] != 0) { ret 1; }
    # nothing reaches the far column
    if (dv_bmp[5 * 4 + 3] != 0) { ret 1; }
    ret 0;
}

test "info: composite outline needs room for every component" {
    build_dejavu();
    var f: Font;
    if (!init(?dv_buf[0], 512, ?f)) { ret 1; }
    var o: glyf.Outline;
    # the first component fits exactly; the second has nowhere to go
    if (glyph_outline(?f, 3, ?dv_pts[0], 4, ?dv_ends[0], 4, ?o)) { ret 1; }
    if (glyph_outline(?f, 3, ?dv_pts[0], 16, ?dv_ends[0], 1, ?o)) { ret 1; }
    ret 0;
}

test "info: self-referencing composite rejected" {
    build_dejavu();
    var f: Font;
    if (!init(?dv_buf[0], 512, ?f)) { ret 1; }
    # point glyph 3's first component at glyph 3
    w16(?dv_buf[0], DV_G3 + 12, 3);
    var o: glyf.Outline;
    if (glyph_outline(?f, 3, ?dv_pts[0], 16, ?dv_ends[0], 4, ?o)) { ret 1; }
    ret 0;
}

test "info: mutually recursive composites rejected" {
    build_dejavu();
    var f: Font;
    if (!init(?dv_buf[0], 512, ?f)) { ret 1; }
    # glyph 5 already references glyph 3; send glyph 3 back to glyph 5
    w16(?dv_buf[0], DV_G3 + 12, 5);
    var o: glyf.Outline;
    if (glyph_outline(?f, 5, ?dv_pts[0], 16, ?dv_ends[0], 4, ?o)) { ret 1; }
    if (glyph_outline(?f, 3, ?dv_pts[0], 16, ?dv_ends[0], 4, ?o)) { ret 1; }
    ret 0;
}

test "info: point-matched component rejected" {
    build_dejavu();
    var f: Font;
    if (!init(?dv_buf[0], 512, ?f)) { ret 1; }
    # clear ARGS_ARE_XY_VALUES, leaving args that are point indices
    w16(?dv_buf[0], DV_G3 + 10, 0x1025);
    var o: glyf.Outline;
    if (glyph_outline(?f, 3, ?dv_pts[0], 16, ?dv_ends[0], 4, ?o)) { ret 1; }
    ret 0;
}

test "info: component out of range rejected" {
    build_dejavu();
    var f: Font;
    if (!init(?dv_buf[0], 512, ?f)) { ret 1; }
    w16(?dv_buf[0], DV_G3 + 12, 99);
    var o: glyf.Outline;
    if (glyph_outline(?f, 3, ?dv_pts[0], 16, ?dv_ends[0], 4, ?o)) { ret 1; }
    ret 0;
}

test "info: kern pairs through the facade" {
    build_dejavu();
    var f: Font;
    if (!init(?dv_buf[0], 512, ?f)) { ret 1; }
    if (f.kern_num_pairs != 4) { ret 1; }

    var v: i16 = 0;
    if (!glyph_kern_advance(?f, 16, 36, ?v)) { ret 1; }
    if (v != -45) { ret 1; }
    if (!glyph_kern_advance(?f, 134, 90, ?v)) { ret 1; }
    if (v != -83) { ret 1; }
    if (!glyph_kern_advance(?f, 134, 92, ?v)) { ret 1; }
    if (v != -139) { ret 1; }
    if (!glyph_kern_advance(?f, 134, 109, ?v)) { ret 1; }
    if (v != -73) { ret 1; }
    # an unkerned pair is not an error
    if (!glyph_kern_advance(?f, 79, 79, ?v)) { ret 1; }
    if (v != 0) { ret 1; }
    ret 0;
}

test "info: a font without kerning reports none" {
    build_font();
    var f: Font;
    if (!init(?font_buf[0], 320, ?f)) { ret 1; }
    if (f.kern_off != 0) { ret 1; }
    var v: i16 = 0;
    if (glyph_kern_advance(?f, 0, 1, ?v)) { ret 1; }
    ret 0;
}

test "info: outline maxima size composite buffers" {
    build_dejavu();
    var f: Font;
    if (!init(?dv_buf[0], 512, ?f)) { ret 1; }
    var m: maxp.Maxima;
    if (!outline_maxima(?f, ?m)) { ret 1; }
    if (m.max_points != 4 || m.max_contours != 1) { ret 1; }
    # the composite maxima are what admit the nested glyph, and they do
    if (m.max_composite_points != 12 || m.max_composite_contours != 3) { ret 1; }
    var o: glyf.Outline;
    if (!glyph_outline(?f, 5, ?dv_pts[0], m.max_composite_points::usize, ?dv_ends[0], m.max_composite_contours::usize, ?o)) { ret 1; }
    if (o.num_points != 12) { ret 1; }
    ret 0;
}
