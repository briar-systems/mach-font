# the parsed-font facade
#
# `Font` is the prepared handle the rest of the api takes: it holds the file
# bytes, the parsed head, the located tables a rasterizer needs, and the outcome
# of selecting the cmap and kern subtables. `init` validates the sfnt header,
# locates the standard tables, and reads the global scalars once. an optional
# table the font lacks is none, and a subtable that could not be selected keeps
# the reason, so the call that needs it reports exactly why it cannot proceed.

use font.cmap;
use font.error.FontError;
use font.error.TableId;
use font.glyf;
use font.head;
use font.hhea;
use font.hmtx;
use font.kern;
use font.loca;
use font.maxp;
use font.raster;
use font.read;
use font.table;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

# a prepared truetype font handle
# ---
# data:       pointer to the first byte of the font file
# len:        number of bytes addressable through data
# head:       the parsed font header, whose units_per_em is never zero
# maxp_off:   byte offset of the maxp table
# num_glyphs: glyph count from maxp
# hhea:       the parsed horizontal header, none when the font has no hhea
# hmtx_off:   byte offset of the hmtx table, none when absent
# loca_off:   byte offset of the loca table, none when absent
# glyf_off:   byte offset of the glyf table, none when absent
# cmap:       absolute offset of the selected unicode cmap subtable, or why none was selected
# kern:       the selected horizontal format-0 kern pairs, or why none were selected
pub rec Font {
    data:       *u8;
    len:        usize;
    head:       head.Head;
    maxp_off:   usize;
    num_glyphs: u16;
    hhea:       opt[hhea.Hhea];
    hmtx_off:   opt[usize];
    loca_off:   opt[usize];
    glyf_off:   opt[usize];
    cmap:       res[usize, FontError];
    kern:       res[kern.Pairs, FontError];
}

# locate a table and return its byte offset, none when the directory lacks it
fun locate(data: *u8, len: usize, a: u8, b: u8, c: u8, d: u8) res[opt[usize], FontError] {
    val t: res[opt[table.Table], FontError] = table.find_table(data, len, a, b, c, d);
    if (sel t.err)     { ret res[opt[usize], FontError].err{t.err}; }
    if (sel t.ok.some) { ret res[opt[usize], FontError].ok{opt[usize].some{t.ok.some.offset::usize}}; }
    ret res[opt[usize], FontError].ok{opt[usize].none{}};
}

# prepare a font handle over an in-memory font file
#
# validates the sfnt version, locates the standard tables, and reads the global
# scalars from head, maxp, and hhea. head and maxp are required. hhea, hmtx, loca,
# glyf, cmap and kern are optional. a cmap or kern table whose subtable cannot be
# selected leaves the font valid, with the reason kept for glyph_index or
# glyph_kern_advance to report.
# ---
# data: pointer to the first byte of the font file
# len:  number of bytes addressable through data
# ret:  the prepared handle, or not_truetype, missing_table (head or maxp), bad_magic,
#       zero_units_per_em or truncated
pub fun init(data: *u8, len: usize) res[Font, FontError] {
    val sfnt: err[FontError] = table.check_truetype(data, len);
    if (sel sfnt.err) { ret res[Font, FontError].err{sfnt.err}; }

    val head_at: res[opt[usize], FontError] = locate(data, len, 'h', 'e', 'a', 'd');
    if (sel head_at.err) { ret res[Font, FontError].err{head_at.err}; }
    val maxp_at: res[opt[usize], FontError] = locate(data, len, 'm', 'a', 'x', 'p');
    if (sel maxp_at.err) { ret res[Font, FontError].err{maxp_at.err}; }
    val hhea_at: res[opt[usize], FontError] = locate(data, len, 'h', 'h', 'e', 'a');
    if (sel hhea_at.err) { ret res[Font, FontError].err{hhea_at.err}; }
    val hmtx_at: res[opt[usize], FontError] = locate(data, len, 'h', 'm', 't', 'x');
    if (sel hmtx_at.err) { ret res[Font, FontError].err{hmtx_at.err}; }
    val loca_at: res[opt[usize], FontError] = locate(data, len, 'l', 'o', 'c', 'a');
    if (sel loca_at.err) { ret res[Font, FontError].err{loca_at.err}; }
    val glyf_at: res[opt[usize], FontError] = locate(data, len, 'g', 'l', 'y', 'f');
    if (sel glyf_at.err) { ret res[Font, FontError].err{glyf_at.err}; }
    val cmap_at: res[opt[usize], FontError] = locate(data, len, 'c', 'm', 'a', 'p');
    if (sel cmap_at.err) { ret res[Font, FontError].err{cmap_at.err}; }
    val kern_at: res[opt[usize], FontError] = locate(data, len, 'k', 'e', 'r', 'n');
    if (sel kern_at.err) { ret res[Font, FontError].err{kern_at.err}; }

    if (!sel head_at.ok.some) { ret res[Font, FontError].err{FontError.missing_table{TableId.head{}}}; }
    if (!sel maxp_at.ok.some) { ret res[Font, FontError].err{FontError.missing_table{TableId.maxp{}}}; }

    var f: Font;
    f.data     = data;
    f.len      = len;
    f.maxp_off = maxp_at.ok.some;
    f.hmtx_off = hmtx_at.ok;
    f.loca_off = loca_at.ok;
    f.glyf_off = glyf_at.ok;

    val h: res[head.Head, FontError] = head.parse_head(data, len, head_at.ok.some);
    if (sel h.err) { ret res[Font, FontError].err{h.err}; }
    f.head = h.ok;

    val glyphs: res[u16, FontError] = maxp.num_glyphs(data, len, maxp_at.ok.some);
    if (sel glyphs.err) { ret res[Font, FontError].err{glyphs.err}; }
    f.num_glyphs = glyphs.ok;

    f.hhea = opt[hhea.Hhea].none{};
    if (sel hhea_at.ok.some) {
        val hh: res[hhea.Hhea, FontError] = hhea.parse_hhea(data, len, hhea_at.ok.some);
        if (sel hh.err) { ret res[Font, FontError].err{hh.err}; }
        f.hhea = opt[hhea.Hhea].some{hh.ok};
    }

    # an unusable cmap leaves the font valid for index-addressed glyph access.
    f.cmap = res[usize, FontError].err{FontError.missing_table{TableId.cmap{}}};
    if (sel cmap_at.ok.some) {
        f.cmap = cmap.select_subtable(data, len, cmap_at.ok.some);
    }

    # kerning is optional in the same way: most fonts carry none.
    f.kern = res[kern.Pairs, FontError].err{FontError.missing_table{TableId.kern{}}};
    if (sel kern_at.ok.some) {
        f.kern = kern.select_subtable(data, len, kern_at.ok.some);
    }

    ret res[Font, FontError].ok{f};
}

# read a glyph's advance width and left-side bearing
#
# a convenience over font.hmtx using the handle's hmtx offset and metric counts.
# ---
# f:     prepared font handle
# glyph: glyph index to resolve
# ret:   the metrics, or missing_table (hhea or hmtx), no_long_metrics,
#        glyph_out_of_range or truncated
pub fun glyph_hmetrics(f: *Font, glyph: u16) res[hmtx.HMetrics, FontError] {
    if (!sel f.hmtx_off.some) { ret res[hmtx.HMetrics, FontError].err{FontError.missing_table{TableId.hmtx{}}}; }
    if (!sel f.hhea.some)     { ret res[hmtx.HMetrics, FontError].err{FontError.missing_table{TableId.hhea{}}}; }
    ret hmtx.metrics(f.data, f.len, f.hmtx_off.some, f.hhea.some.num_h_metrics, f.num_glyphs, glyph);
}

# read the kerning correction applied between two adjacent glyphs
#
# a convenience over font.kern using the handle's selected pair array. the value
# adds to the left glyph's advance width, so a negative value tucks the pair
# closer together. a pair the font does not kern yields 0, and a font that does
# not kern at all reports why, which is how a caller tells the two apart.
# ---
# f:     prepared font handle
# left:  glyph index of the left-hand glyph
# right: glyph index of the right-hand glyph
# ret:   the correction in font units, or the reason the font has no usable kerning
pub fun glyph_kern_advance(f: *Font, left: u16, right: u16) res[i16, FontError] {
    if (sel f.kern.err) { ret res[i16, FontError].err{f.kern.err}; }
    ret kern.lookup(f.data, f.len, f.kern.ok, left, right);
}

# map a unicode codepoint to a glyph index through the selected cmap subtable
#
# a convenience over font.cmap using the handle's selected subtable. an unmapped
# codepoint yields glyph 0.
# ---
# f:         prepared font handle
# codepoint: the unicode codepoint to map
# ret:       the glyph index, or the reason the font has no usable cmap, cmap_format
#            or truncated
pub fun glyph_index(f: *Font, codepoint: u32) res[u16, FontError] {
    if (sel f.cmap.err) { ret res[u16, FontError].err{f.cmap.err}; }
    ret cmap.lookup(f.data, f.len, f.cmap.ok, codepoint);
}

# how deeply composite glyphs may nest before a reference chain is rejected
#
# real fonts nest a level or two, an accented letter built from a letter and a
# mark, occasionally over an already-accented letter. a chain longer than this is
# either malformed or cyclic, and the cap is what turns a self-referencing glyph
# into a clean rejection instead of unbounded recursion.
val MAX_COMPOSITE_DEPTH: usize = 5;

# the located glyph data an outline walk reads from
rec Outlines {
    loca: usize;
    glyf: usize;
}

# resolve the loca and glyf tables an outline walk needs
fun outlines(f: *Font) res[Outlines, FontError] {
    if (!sel f.loca_off.some) { ret res[Outlines, FontError].err{FontError.missing_table{TableId.loca{}}}; }
    if (!sel f.glyf_off.some) { ret res[Outlines, FontError].err{FontError.missing_table{TableId.glyf{}}}; }
    ret res[Outlines, FontError].ok{Outlines{loca: f.loca_off.some, glyf: f.glyf_off.some}};
}

# append one glyph's outline to the buffers under an accumulated transform
#
# a simple glyph extracts straight into the free tail of the buffers, has the
# transform applied, and has its contour ends biased past the points already
# written. a composite glyph instead walks its component records, composing each
# component's placement onto the running transform and recursing.
fun compose(f: *Font, at: Outlines, glyph: u16, m: *glyf.Xform, depth: usize, pts: *glyf.Point, pts_cap: usize, ends: *u16, ends_cap: usize, io: *glyf.Outline) err[FontError] {
    if (depth > MAX_COMPOSITE_DEPTH) { ret err[FontError].err{FontError.composite_depth{}}; }
    if (glyph >= f.num_glyphs)       { ret err[FontError].err{FontError.glyph_out_of_range{glyph}}; }

    val range: res[loca.GlyphRange, FontError] = loca.glyph_range(f.data, f.len, at.loca, f.head.index_to_loc_format, glyph);
    if (sel range.err) { ret err[FontError].err{range.err}; }
    # an empty glyph contributes nothing, whether it is the whole request or a component.
    if (loca.is_empty(?range.ok)) { ret err[FontError].ok{}; }

    val goff: usize                          = at.glyf + range.ok.start::usize;
    val info: res[glyf.GlyphInfo, FontError] = glyf.glyph_header(f.data, f.len, goff);
    if (sel info.err) { ret err[FontError].err{info.err}; }

    if (!glyf.is_composite(?info.ok)) {
        val base_pts:  usize = io.num_points::usize;
        val base_ends: usize = io.num_contours::usize;

        val sub: res[glyf.Outline, FontError] = glyf.extract_simple(f.data, f.len, goff, ?pts[base_pts], pts_cap - base_pts, ?ends[base_ends], ends_cap - base_ends);
        if (sel sub.err)                                  { ret err[FontError].err{sub.err}; }
        if (base_pts + sub.ok.num_points::usize > 0xFFFF) { ret err[FontError].err{FontError.too_many_points{}}; }

        glyf.xform_apply(m, ?pts[base_pts], sub.ok.num_points::usize);

        var i: usize = 0;
        for (i < sub.ok.num_contours::usize) {
            ends[base_ends + i] = ends[base_ends + i] + base_pts::u16;
            i                   = i + 1;
        }

        io.num_points   = io.num_points + sub.ok.num_points;
        io.num_contours = io.num_contours + sub.ok.num_contours;
        ret err[FontError].ok{};
    }

    var off:  usize = goff + glyf.COMPONENTS_OFFSET;
    var more: bool  = true;
    for (more) {
        val c: res[glyf.Component, FontError] = glyf.read_component(f.data, f.len, off);
        if (sel c.err) { ret err[FontError].err{c.err}; }
        # point-matched placement aligns a component by point index rather than an
        # offset. it is not resolved here, so such a glyph is rejected outright.
        if ((c.ok.flags & glyf.ARGS_ARE_XY_VALUES) == 0) { ret err[FontError].err{FontError.point_matched_component{}}; }

        var child: glyf.Xform;
        glyf.xform_compose(m, ?c.ok.m, ?child);
        val placed: err[FontError] = compose(f, at, c.ok.glyph, ?child, depth + 1, pts, pts_cap, ends, ends_cap, io);
        if (sel placed.err) { ret placed; }

        more = (c.ok.flags & glyf.MORE_COMPONENTS) != 0;
        off  = c.ok.next;
    }
    ret err[FontError].ok{};
}

# extract a glyph's outline into caller-provided buffers
#
# resolves the glyph's data range through loca and extracts its contours through
# glyf. a composite glyph is resolved recursively: each component's outline is
# appended under the component's transform, so the result is one flat point and
# contour list a rasterizer consumes exactly like a simple glyph's. an empty glyph
# (no outline, e.g. a space) succeeds with zero counts. a composite nesting past
# MAX_COMPOSITE_DEPTH is how a cyclic reference is caught. sizing the buffers
# from maxp's storage maxima admits every glyph in the font.
# ---
# f:        prepared font handle
# glyph:    glyph index to extract
# pts:      buffer receiving the extracted points
# pts_cap:  capacity of pts in points
# ends:     buffer receiving each contour's end point index
# ends_cap: capacity of ends in entries
# ret:      the written contour and point counts, or missing_table (loca or glyf),
#           glyph_out_of_range, points_full, contours_full, composite_depth,
#           point_matched_component, too_many_points, a loca failure or truncated
pub fun glyph_outline(f: *Font, glyph: u16, pts: *glyf.Point, pts_cap: usize, ends: *u16, ends_cap: usize) res[glyf.Outline, FontError] {
    val at: res[Outlines, FontError] = outlines(f);
    if (sel at.err)            { ret res[glyf.Outline, FontError].err{at.err}; }
    if (glyph >= f.num_glyphs) { ret res[glyf.Outline, FontError].err{FontError.glyph_out_of_range{glyph}}; }

    var m: glyf.Xform;
    glyf.xform_identity(?m);
    var o:    glyf.Outline   = glyf.Outline{num_contours: 0, num_points: 0};
    val done: err[FontError] = compose(f, at.ok, glyph, ?m, 0, pts, pts_cap, ends, ends_cap, ?o);
    if (sel done.err) { ret res[glyf.Outline, FontError].err{done.err}; }
    ret res[glyf.Outline, FontError].ok{o};
}

# read a glyph's header, its contour count and bounding box
#
# an empty glyph stores no header, so it has none.
# ---
# f:     prepared font handle
# glyph: glyph index to read
# ret:   the header, none for an empty glyph, or missing_table (loca or glyf),
#        glyph_out_of_range, a loca failure or truncated
pub fun glyph_info(f: *Font, glyph: u16) res[opt[glyf.GlyphInfo], FontError] {
    val at: res[Outlines, FontError] = outlines(f);
    if (sel at.err)            { ret res[opt[glyf.GlyphInfo], FontError].err{at.err}; }
    if (glyph >= f.num_glyphs) { ret res[opt[glyf.GlyphInfo], FontError].err{FontError.glyph_out_of_range{glyph}}; }

    val range: res[loca.GlyphRange, FontError] = loca.glyph_range(f.data, f.len, at.ok.loca, f.head.index_to_loc_format, glyph);
    if (sel range.err)            { ret res[opt[glyf.GlyphInfo], FontError].err{range.err}; }
    if (loca.is_empty(?range.ok)) { ret res[opt[glyf.GlyphInfo], FontError].ok{opt[glyf.GlyphInfo].none{}}; }

    val info: res[glyf.GlyphInfo, FontError] = glyf.glyph_header(f.data, f.len, at.ok.glyf + range.ok.start::usize);
    if (sel info.err) { ret res[opt[glyf.GlyphInfo], FontError].err{info.err}; }
    ret res[opt[glyf.GlyphInfo], FontError].ok{opt[glyf.GlyphInfo].some{info.ok}};
}

# read the point and contour bounds that size outline buffers for this font
#
# a convenience over font.maxp: buffers sized to the larger of the simple and
# composite maxima admit glyph_outline for any glyph in the font.
# ---
# f:   prepared font handle
# ret: the maxima, none when the font's maxp is the 0.5 version, or maxp_version
#      or truncated
pub fun outline_maxima(f: *Font) res[opt[maxp.Maxima], FontError] {
    ret maxp.storage_maxima(f.data, f.len, f.maxp_off);
}

# compute the scale that maps the font's design space to a target pixel height
#
# the height spans the font's ascent-to-descent range. this differs from an em
# size whenever the face extends above or below its em square.
# ---
# f:      prepared font handle
# pixels: desired ascent-to-descent height in pixels
# ret:    design-unit-to-pixel scale, or missing_table (hhea) or vertical_span
pub fun scale_for_pixel_height(f: *Font, pixels: f32) res[f32, FontError] {
    if (!sel f.hhea.some) { ret res[f32, FontError].err{FontError.missing_table{TableId.hhea{}}}; }
    val span: i32 = f.hhea.some.ascent::i32 - f.hhea.some.descent::i32;
    if (span <= 0) { ret res[f32, FontError].err{FontError.vertical_span{span}}; }
    ret res[f32, FontError].ok{pixels / span::f32};
}

# compute the scale that maps one em to a target pixel size
#
# font apis conventionally name a face by this size. a font designed on a pixel
# grid needs it specifically: an 11-pixel em over 550 design units maps every
# 50-unit cell to exactly one pixel even when ascenders and descenders extend
# beyond the em square. init refuses a zero units-per-em, so this cannot fail.
# ---
# f:      prepared font handle
# pixels: desired em size in pixels
# ret:    design-unit-to-pixel scale
pub fun scale_for_em_size(f: *Font, pixels: f32) f32 {
    ret pixels / f.head.units_per_em::f32;
}

# render a glyph into an 8-bit coverage bitmap at the given scale
#
# extracts the glyph outline, flattens its curves, and fills the bitmap with the
# glyph placed against its own bounding box: the glyph's lower-left corner maps to
# the bitmap's lower-left. every pixel is written, so the bitmap need not be
# pre-cleared. an empty glyph clears the bitmap to zero. a composite glyph renders
# like any other: its components are composed into one outline first. the caller
# sizes the points, contour-ends, and edges scratch buffers.
# ---
# f:         prepared font handle
# glyph:     glyph index to render
# scale:     design-unit-to-pixel scale, e.g. from scale_for_pixel_height
# pts:       scratch buffer for extracted points
# pts_cap:   capacity of pts
# ends:      scratch buffer for contour end indices
# ends_cap:  capacity of ends
# edges:     scratch buffer for flattened edges
# edges_cap: capacity of edges
# bitmap:    row-major width*height output buffer
# width:     bitmap width in pixels
# height:    bitmap height in pixels
# ret:       ok on a fully rendered (possibly empty) glyph, or any glyph_outline
#            failure, contour_end or edges_full
pub fun render_glyph(f: *Font, glyph: u16, scale: f32, pts: *glyf.Point, pts_cap: usize, ends: *u16, ends_cap: usize, edges: *raster.Edge, edges_cap: usize, bitmap: *u8, width: u16, height: u16) err[FontError] {
    val o: res[glyf.Outline, FontError] = glyph_outline(f, glyph, pts, pts_cap, ends, ends_cap);
    if (sel o.err) { ret err[FontError].err{o.err}; }

    val info: res[opt[glyf.GlyphInfo], FontError] = glyph_info(f, glyph);
    if (sel info.err) { ret err[FontError].err{info.err}; }
    # an empty glyph stores no header, and a header over no points draws nothing.
    if (!sel info.ok.some) {
        clear_bitmap(bitmap, width, height);
        ret err[FontError].ok{};
    }
    if (o.ok.num_points == 0) {
        clear_bitmap(bitmap, width, height);
        ret err[FontError].ok{};
    }

    # place the glyph against its bounding box so its lower-left maps to the origin.
    val x_off: f32 = -(info.ok.some.x_min::f32) * scale;
    val y_off: f32 = -(info.ok.some.y_min::f32) * scale;

    val count: res[usize, FontError] = raster.flatten(pts, o.ok.num_points, ends, o.ok.num_contours, scale, x_off, y_off, height, edges, edges_cap);
    if (sel count.err) { ret err[FontError].err{count.err}; }
    raster.fill(edges, count.ok, bitmap, width, height);
    ret err[FontError].ok{};
}

# write zero coverage across the whole bitmap
fun clear_bitmap(bitmap: *u8, width: u16, height: u16) {
    val n: usize = width::usize * height::usize;
    var i: usize = 0;
    for (i < n) {
        bitmap[i] = 0;
        i         = i + 1;
    }
}

fun w16(buf: *u8, off: usize, v: u16) {
    buf[off]     = (v >> 8)::u8;
    buf[off + 1] = (v & 0xFF)::u8;
}

fun w32(buf: *u8, off: usize, v: u32) {
    buf[off]     = (v >> 24)::u8;
    buf[off + 1] = ((v >> 16) & 0xFF)::u8;
    buf[off + 2] = ((v >> 8) & 0xFF)::u8;
    buf[off + 3] = (v & 0xFF)::u8;
}

fun tag(buf: *u8, off: usize, a: u8, b: u8, c: u8, d: u8) {
    buf[off]     = a;
    buf[off + 1] = b;
    buf[off + 2] = c;
    buf[off + 3] = d;
}

# a complete minimal font: head, maxp, hhea, hmtx, cmap, loca, glyf. two glyphs
# (0 empty, 1 a triangle); the cmap maps 'A' to glyph 1. tables built by hand,
# mirroring the parsers in reverse.
var font_buf: [320]u8;

fun build_font() {
    val p: *u8 = ?font_buf[0];

    w32(p, 0, 0x00010000); # sfnt version
    w16(p, 4, 7); # numTables
    w16(p, 6, 0);
    w16(p, 8, 0);
    w16(p, 10, 0);

    # directory entries: tag, checksum (0), offset, length
    tag(p, 12, 'c', 'm', 'a', 'p');
    w32(p, 20, 228);
    w32(p, 24, 44);
    tag(p, 28, 'g', 'l', 'y', 'f');
    w32(p, 36, 278);
    w32(p, 40, 24);
    tag(p, 44, 'h', 'e', 'a', 'd');
    w32(p, 52, 124);
    w32(p, 56, 54);
    tag(p, 60, 'h', 'h', 'e', 'a');
    w32(p, 68, 184);
    w32(p, 72, 36);
    tag(p, 76, 'h', 'm', 't', 'x');
    w32(p, 84, 220);
    w32(p, 88, 8);
    tag(p, 92, 'l', 'o', 'c', 'a');
    w32(p, 100, 272);
    w32(p, 104, 6);
    tag(p, 108, 'm', 'a', 'x', 'p');
    w32(p, 116, 178);
    w32(p, 120, 6);

    # head @124
    font_buf[124 + 12] = 0x5F;
    font_buf[124 + 13] = 0x0F;
    font_buf[124 + 14] = 0x3C;
    font_buf[124 + 15] = 0xF5;
    w16(p, 124 + 18, 1000); # units_per_em
    w16(p, 124 + 50, 0); # index_to_loc_format = short

    # maxp @178
    w32(p, 178, 0x00010000);
    w16(p, 178 + 4, 2); # numGlyphs

    # hhea @184
    w16(p, 184 + 4, 800); # ascent
    w16(p, 184 + 6, 0xFF38); # descent = -200
    w16(p, 184 + 34, 2); # num_h_metrics

    # hmtx @220: 2 long metrics
    w16(p, 220 + 0, 500); # glyph 0 advance
    w16(p, 220 + 2, 0); # glyph 0 lsb
    w16(p, 220 + 4, 650); # glyph 1 advance
    w16(p, 220 + 6, 40); # glyph 1 lsb

    # cmap @228
    w16(p, 228 + 0, 0); # version
    w16(p, 228 + 2, 1); # numTables
    w16(p, 228 + 4, 3); # platformID = windows
    w16(p, 228 + 6, 1); # encodingID = BMP unicode
    w32(p, 228 + 8, 12); # subtable offset (relative to cmap)
    # format 4 subtable @240: 'A' -> glyph 1
    w16(p, 240 + 0, 4); # format
    w16(p, 240 + 2, 32); # length
    w16(p, 240 + 4, 0); # language
    w16(p, 240 + 6, 4); # segCountX2 (2 segments)
    w16(p, 254, 0x41); # endCode[0]
    w16(p, 256, 0xFFFF); # endCode[1]
    w16(p, 258, 0); # reservedPad
    w16(p, 260, 0x41); # startCode[0]
    w16(p, 262, 0xFFFF); # startCode[1]
    w16(p, 264, 0xFFC0); # idDelta[0] = -64: 'A'(0x41) -> 1
    w16(p, 266, 1); # idDelta[1]
    w16(p, 268, 0); # idRangeOffset[0]
    w16(p, 270, 0); # idRangeOffset[1]

    # loca @272: short offsets (halved). glyph 0 empty, glyph 1 = [0, 24)
    w16(p, 272, 0);
    w16(p, 274, 0);
    w16(p, 276, 12);

    # glyf @278: glyph 1 is a triangle (100,100), (300,100), (200,400)
    w16(p, 278, 1); # numberOfContours
    w16(p, 280, 100); # xMin
    w16(p, 282, 100); # yMin
    w16(p, 284, 300); # xMax
    w16(p, 286, 400); # yMax
    w16(p, 288, 2); # endPtsOfContours[0]
    w16(p, 290, 0); # instructionLength
    font_buf[292] = 0x37; # p0: on, x short +, y short +
    font_buf[293] = 0x33; # p1: on, x short +, y same
    font_buf[294] = 0x03; # p2: on, x short -, y i16
    font_buf[295] = 100; # p0 x = +100
    font_buf[296] = 200; # p1 x = +200
    font_buf[297] = 100; # p2 x = -100
    font_buf[298] = 100; # p0 y = +100
    w16(p, 299, 300); # p2 y = +300 (i16)
}

var e2e_pts:   [8]glyf.Point;
var e2e_ends:  [4]u16;
var e2e_edges: [64]raster.Edge;
var e2e_bmp:   [64]u8;

# prepare a fixture font, reporting failure as a zeroed handle
fun opened(data: *u8, len: usize) Font {
    val r: res[Font, FontError] = init(data, len);
    if (sel r.ok) { ret r.ok; }
    var zero: Font;
    ret zero;
}

# test whether an outline extraction succeeded with these counts
fun outlined(r: res[glyf.Outline, FontError], contours: u16, points: u16) bool {
    if (sel r.ok) { ret r.ok.num_contours == contours && r.ok.num_points == points; }
    ret false;
}

# test whether an outline extraction failed
fun refused(r: res[glyf.Outline, FontError]) bool {
    ret sel r.err;
}

# test whether an operation succeeded
fun done(r: err[FontError]) bool {
    ret sel r.ok;
}

test "info: init locates every table and reads globals" {
    build_font();
    val r: res[Font, FontError] = init(?font_buf[0], 320);
    if (!sel r.ok) { ret 1; }
    val f: Font = r.ok;
    if (f.head.units_per_em != 1000)                              { ret 2; }
    if (f.head.index_to_loc_format != 0)                          { ret 3; }
    if (f.num_glyphs != 2)                                        { ret 4; }
    if (!sel f.hhea.some)                                         { ret 5; }
    if (f.hhea.some.num_h_metrics != 2)                           { ret 6; }
    if (f.hhea.some.ascent != 800 || f.hhea.some.descent != -200) { ret 7; }
    if (!sel f.glyf_off.some)                                     { ret 8; }
    if (f.glyf_off.some != 278)                                   { ret 9; }
    if (!sel f.loca_off.some)                                     { ret 10; }
    if (f.loca_off.some != 272)                                   { ret 11; }
    if (!sel f.cmap.ok)                                           { ret 12; }
    if (f.cmap.ok != 240)                                         { ret 13; }
    ret 0;
}

test "info: em sizing is independent of the line metrics" {
    var f: Font;
    f.head.units_per_em = 550;
    f.hhea              = opt[hhea.Hhea].some{hhea.Hhea{ascent: 550, descent: -150, line_gap: 0, advance_width_max: 0, num_h_metrics: 0}};
    if (scale_for_em_size(?f, 11.0) != 0.02) { ret 1; }
    val line: res[f32, FontError] = scale_for_pixel_height(?f, 11.0);
    if (!sel line.ok)    { ret 2; }
    if (line.ok == 0.02) { ret 3; }
    ret 0;
}

test "info: pixel height needs vertical metrics" {
    var f: Font;
    f.head.units_per_em = 550;
    f.hhea              = opt[hhea.Hhea].none{};
    val absent: res[f32, FontError] = scale_for_pixel_height(?f, 11.0);
    if (!sel absent.err)                    { ret 1; }
    if (!sel absent.err.missing_table)      { ret 2; }
    if (!sel absent.err.missing_table.hhea) { ret 3; }
    f.hhea = opt[hhea.Hhea].some{hhea.Hhea{ascent: 0, descent: 0, line_gap: 0, advance_width_max: 0, num_h_metrics: 0}};
    val flat: res[f32, FontError] = scale_for_pixel_height(?f, 11.0);
    if (!sel flat.err)               { ret 4; }
    if (!sel flat.err.vertical_span) { ret 5; }
    ret 0;
}

test "info: cmap maps 'A' to glyph 1" {
    build_font();
    var f: Font                = opened(?font_buf[0], 320);
    val a: res[u16, FontError] = glyph_index(?f, 0x41);
    if (!sel a.ok) { ret 1; }
    if (a.ok != 1) { ret 2; }
    # an unmapped codepoint resolves to glyph 0
    val b: res[u16, FontError] = glyph_index(?f, 0x42);
    if (!sel b.ok) { ret 3; }
    if (b.ok != 0) { ret 4; }
    ret 0;
}

test "info: glyph_hmetrics via facade" {
    build_font();
    var f: Font                          = opened(?font_buf[0], 320);
    val m: res[hmtx.HMetrics, FontError] = glyph_hmetrics(?f, 1);
    if (!sel m.ok)                             { ret 1; }
    if (m.ok.advance != 650 || m.ok.lsb != 40) { ret 2; }
    ret 0;
}

test "info: outline extraction end to end" {
    build_font();
    var f: Font = opened(?font_buf[0], 320);
    if (!outlined(glyph_outline(?f, 1, ?e2e_pts[0], 8, ?e2e_ends[0], 4), 1, 3)) { ret 1; }
    if (e2e_pts[0].x != 100 || e2e_pts[0].y != 100)                             { ret 2; }
    if (e2e_pts[1].x != 300 || e2e_pts[1].y != 100)                             { ret 3; }
    if (e2e_pts[2].x != 200 || e2e_pts[2].y != 400)                             { ret 4; }
    # glyph 0 is empty
    if (!outlined(glyph_outline(?f, 0, ?e2e_pts[0], 8, ?e2e_ends[0], 4), 0, 0)) { ret 5; }
    ret 0;
}

test "info: glyph info reads the header and skips empty glyphs" {
    build_font();
    var f:   Font                                = opened(?font_buf[0], 320);
    val tri: res[opt[glyf.GlyphInfo], FontError] = glyph_info(?f, 1);
    if (!sel tri.ok)                                          { ret 1; }
    if (!sel tri.ok.some)                                     { ret 2; }
    if (tri.ok.some.x_min != 100 || tri.ok.some.y_max != 400) { ret 3; }
    val empty: res[opt[glyf.GlyphInfo], FontError] = glyph_info(?f, 0);
    if (!sel empty.ok)      { ret 4; }
    if (!sel empty.ok.none) { ret 5; }
    val past: res[opt[glyf.GlyphInfo], FontError] = glyph_info(?f, 2);
    if (!sel past.err)                    { ret 6; }
    if (!sel past.err.glyph_out_of_range) { ret 7; }
    ret 0;
}

test "info: render glyph covers interior, leaves corner empty" {
    build_font();
    var f: Font = opened(?font_buf[0], 320);
    if (!done(render_glyph(?f, 1, 0.02, ?e2e_pts[0], 8, ?e2e_ends[0], 4, ?e2e_edges[0], 64, ?e2e_bmp[0], 8, 8))) { ret 1; }
    # the triangle centroid maps near pixel (2, 6)
    if (e2e_bmp[6 * 8 + 2] == 0) { ret 2; }
    # a far corner stays empty
    if (e2e_bmp[7] != 0) { ret 3; }
    ret 0;
}

test "info: non-truetype rejected" {
    build_font();
    w32(?font_buf[0], 0, 0x4F54544F); # OTTO
    val r: res[Font, FontError] = init(?font_buf[0], 320);
    if (!sel r.err)              { ret 1; }
    if (!sel r.err.not_truetype) { ret 2; }
    ret 0;
}

test "info: truncated font rejected" {
    build_font();
    # the directory claims 7 tables but only a few bytes are present
    val r: res[Font, FontError] = init(?font_buf[0], 20);
    if (!sel r.err)           { ret 1; }
    if (!sel r.err.truncated) { ret 2; }
    ret 0;
}

test "info: missing required table rejected" {
    build_font();
    tag(?font_buf[0], 108, 'm', 'a', 'x', 'q');
    val r: res[Font, FontError] = init(?font_buf[0], 320);
    if (!sel r.err)                    { ret 1; }
    if (!sel r.err.missing_table)      { ret 2; }
    if (!sel r.err.missing_table.maxp) { ret 3; }
    ret 0;
}

# a second font carrying dejavu sans' composite geometry: the glyphs, component
# offsets, kerning values and metrics below are that font's real numbers at its
# 2048 units per em, cross-checked against an independent resolution of the same
# outlines. only the glyph indices are renumbered, so six glyphs stand in for
# dejavu's several thousand:
#
#   1  dotbelowcomb    simple, one rectangular contour
#   2  l               simple, one rectangular contour
#   3  uni1E37         composite: dotbelowcomb at x+807, l at x+11
#   4  macron          simple, one rectangular contour
#   5  uni1E39         composite: macron at (-216, +315), uni1E37 at the origin
#
# glyph 5 nests a composite inside a composite, which is what exercises the
# recursive walk past one level.
var dv_buf: [512]u8;

# byte offset of the first composite glyph within dv_buf
val DV_G3: usize = 376;

# write a one-contour rectangle glyph: 34 bytes, all points on-curve, every
# coordinate an i16 delta
fun rect_glyph(p: *u8, at: usize, x0: i16, y0: i16, x1: i16, y1: i16) {
    w16(p, at, 1);
    w16(p, at + 2, x0:~u16);
    w16(p, at + 4, y0:~u16);
    w16(p, at + 6, x1:~u16);
    w16(p, at + 8, y1:~u16);
    w16(p, at + 10, 3); # endPtsOfContours[0]
    w16(p, at + 12, 0); # instructionLength
    p[at + 14] = 0x01; # every point on-curve with i16 deltas
    p[at + 15] = 0x01;
    p[at + 16] = 0x01;
    p[at + 17] = 0x01;
    w16(p, at + 18, x0:~u16); # x deltas, walking the rectangle
    w16(p, at + 20, (x1 - x0):~u16);
    w16(p, at + 22, 0);
    w16(p, at + 24, (x0 - x1):~u16);
    w16(p, at + 26, y1:~u16); # y deltas
    w16(p, at + 28, 0);
    w16(p, at + 30, (y0 - y1):~u16);
    w16(p, at + 32, 0);
}

fun build_dejavu() {
    val p: *u8 = ?dv_buf[0];

    w32(p, 0, 0x00010000);
    w16(p, 4, 7); # numTables

    tag(p, 12, 'g', 'l', 'y', 'f');
    w32(p, 20, 308);
    w32(p, 24, 150);
    tag(p, 28, 'h', 'e', 'a', 'd');
    w32(p, 36, 124);
    w32(p, 40, 54);
    tag(p, 44, 'h', 'h', 'e', 'a');
    w32(p, 52, 192);
    w32(p, 56, 36);
    tag(p, 60, 'h', 'm', 't', 'x');
    w32(p, 68, 228);
    w32(p, 72, 24);
    tag(p, 76, 'k', 'e', 'r', 'n');
    w32(p, 84, 266);
    w32(p, 88, 42);
    tag(p, 92, 'l', 'o', 'c', 'a');
    w32(p, 100, 252);
    w32(p, 104, 14);
    tag(p, 108, 'm', 'a', 'x', 'p');
    w32(p, 116, 178);
    w32(p, 120, 14);

    # head @124
    dv_buf[124 + 12] = 0x5F;
    dv_buf[124 + 13] = 0x0F;
    dv_buf[124 + 14] = 0x3C;
    dv_buf[124 + 15] = 0xF5;
    w16(p, 124 + 18, 2048); # units_per_em
    w16(p, 124 + 50, 0); # index_to_loc_format = short

    # maxp @178
    w32(p, 178, 0x00010000);
    w16(p, 178 + 4, 6); # numGlyphs
    w16(p, 178 + 6, 4); # maxPoints
    w16(p, 178 + 8, 1); # maxContours
    w16(p, 178 + 10, 12); # maxCompositePoints
    w16(p, 178 + 12, 3); # maxCompositeContours

    # hhea @192
    w16(p, 192 + 4, 1901); # ascent
    w16(p, 192 + 6, 0xFE1D); # descent = -483
    w16(p, 192 + 34, 6); # num_h_metrics

    # hmtx @228: only glyph 3 carries dejavu's own advance and bearing
    w16(p, 228 + 0, 1024);
    w16(p, 228 + 2, 0);
    w16(p, 228 + 4, 0);
    w16(p, 228 + 6, 0xFDA2);
    w16(p, 228 + 8, 569);
    w16(p, 228 + 10, 193);
    w16(p, 228 + 12, 589);
    w16(p, 228 + 14, 201);
    w16(p, 228 + 16, 1024);
    w16(p, 228 + 18, 213);
    w16(p, 228 + 20, 589);
    w16(p, 228 + 22, 0xFFFD);

    # loca @252: short offsets, halved. glyph 0 is empty
    w16(p, 252, 0);
    w16(p, 254, 0);
    w16(p, 256, 17); # 34
    w16(p, 258, 34); # 68
    w16(p, 260, 46); # 92
    w16(p, 262, 63); # 126
    w16(p, 264, 75); # 150

    # kern @266: one horizontal format-0 subtable of four real dejavu pairs
    w16(p, 266, 0); # version
    w16(p, 268, 1); # nTables
    w16(p, 270, 0); # subtable version
    w16(p, 272, 38); # subtable length
    w16(p, 274, 0x0001); # coverage: format 0, horizontal
    w16(p, 276, 4); # nPairs
    w16(p, 278, 24); # searchRange
    w16(p, 280, 2); # entrySelector
    w16(p, 282, 0); # rangeShift
    w16(p, 284, 16);
    w16(p, 286, 36);
    w16(p, 288, 0xFFD3); # hyphen, A: -45
    w16(p, 290, 134);
    w16(p, 292, 90);
    w16(p, 294, 0xFFAD); # Adieresis, w: -83
    w16(p, 296, 134);
    w16(p, 298, 92);
    w16(p, 300, 0xFF75); # Adieresis, y: -139
    w16(p, 302, 134);
    w16(p, 304, 109);
    w16(p, 306, 0xFFB7); # Adieresis, guillemotleft: -73

    # glyf @308
    rect_glyph(p, 308, -606, -375, -422, -141); # glyph 1: dotbelowcomb
    rect_glyph(p, 342, 193, 0, 377, 1556); # glyph 2: l
    rect_glyph(p, 400, 213, 1378, 811, 1526); # glyph 4: macron

    # glyph 3 @376: composite of dotbelowcomb and l
    w16(p, 376, 0xFFFF); # numberOfContours = -1
    w16(p, 378, 201); # xMin
    w16(p, 380, 0xFE89); # yMin = -375
    w16(p, 382, 388); # xMax
    w16(p, 384, 1556); # yMax
    w16(p, 386, 0x1027); # words, xy values, round to grid, more, unscaled offset
    w16(p, 388, 1); # component glyph
    w16(p, 390, 807); # x offset
    w16(p, 392, 0); # y offset
    w16(p, 394, 0x1006); # bytes, xy values, round to grid, unscaled offset
    w16(p, 396, 2); # component glyph
    dv_buf[398] = 11; # x offset
    dv_buf[399] = 0; # y offset

    # glyph 5 @434: composite of macron and the composite glyph 3
    w16(p, 434, 0xFFFF);
    w16(p, 436, 0xFFFD); # xMin = -3
    w16(p, 438, 0xFE89); # yMin = -375
    w16(p, 440, 595); # xMax
    w16(p, 442, 1841); # yMax
    w16(p, 444, 0x1027);
    w16(p, 446, 4); # component glyph: macron
    w16(p, 448, 0xFF28); # x offset = -216
    w16(p, 450, 315); # y offset
    w16(p, 452, 0x1006);
    w16(p, 454, 3); # component glyph: the composite
    dv_buf[456] = 0;
    dv_buf[457] = 0;
}

var dv_pts:   [16]glyf.Point;
var dv_ends:  [4]u16;
var dv_edges: [128]raster.Edge;
var dv_bmp:   [80]u8;

test "info: composite outline composes its components" {
    build_dejavu();
    var f: Font = opened(?dv_buf[0], 512);
    if (f.head.units_per_em != 2048) { ret 1; }

    if (!outlined(glyph_outline(?f, 3, ?dv_pts[0], 16, ?dv_ends[0], 4), 2, 8)) { ret 2; }
    # each component's contour ends past the points already written
    if (dv_ends[0] != 3 || dv_ends[1] != 7) { ret 3; }

    # dotbelowcomb shifted right by 807
    if (dv_pts[0].x != 201 || dv_pts[0].y != -141) { ret 4; }
    if (dv_pts[1].x != 385 || dv_pts[1].y != -141) { ret 4; }
    if (dv_pts[2].x != 385 || dv_pts[2].y != -375) { ret 4; }
    if (dv_pts[3].x != 201 || dv_pts[3].y != -375) { ret 4; }
    # l shifted right by 11
    if (dv_pts[4].x != 204 || dv_pts[4].y != 1556) { ret 5; }
    if (dv_pts[5].x != 388 || dv_pts[5].y != 1556) { ret 5; }
    if (dv_pts[6].x != 388 || dv_pts[6].y != 0)    { ret 5; }
    if (dv_pts[7].x != 204 || dv_pts[7].y != 0)    { ret 5; }

    val m: res[hmtx.HMetrics, FontError] = glyph_hmetrics(?f, 3);
    if (!sel m.ok)                              { ret 6; }
    if (m.ok.advance != 589 || m.ok.lsb != 201) { ret 7; }
    ret 0;
}

test "info: nested composite resolves both levels" {
    build_dejavu();
    var f: Font = opened(?dv_buf[0], 512);

    if (!outlined(glyph_outline(?f, 5, ?dv_pts[0], 16, ?dv_ends[0], 4), 3, 12)) { ret 1; }
    if (dv_ends[0] != 3 || dv_ends[1] != 7 || dv_ends[2] != 11)                 { ret 2; }

    # macron shifted by (-216, +315)
    if (dv_pts[0].x != -3 || dv_pts[0].y != 1841)  { ret 3; }
    if (dv_pts[1].x != 595 || dv_pts[1].y != 1841) { ret 3; }
    if (dv_pts[2].x != 595 || dv_pts[2].y != 1693) { ret 3; }
    if (dv_pts[3].x != -3 || dv_pts[3].y != 1693)  { ret 3; }
    # the nested composite lands where it does on its own, placed at the origin
    if (dv_pts[4].x != 201 || dv_pts[4].y != -141) { ret 4; }
    if (dv_pts[8].x != 204 || dv_pts[8].y != 1556) { ret 4; }
    if (dv_pts[11].x != 204 || dv_pts[11].y != 0)  { ret 4; }
    ret 0;
}

test "info: composite renders both components" {
    build_dejavu();
    var f: Font = opened(?dv_buf[0], 512);
    # 1931 design units of height across 20 rows, and the glyph is under 2 px wide
    if (!done(render_glyph(?f, 3, 0.01035, ?dv_pts[0], 16, ?dv_ends[0], 4, ?dv_edges[0], 128, ?dv_bmp[0], 4, 20))) { ret 1; }
    # the stem runs down the upper rows and the dot sits at the bottom
    if (dv_bmp[5 * 4 + 1] == 0)  { ret 2; }
    if (dv_bmp[18 * 4 + 1] == 0) { ret 3; }
    # the gap between them is what proves the two components stayed apart
    if (dv_bmp[16 * 4 + 1] != 0) { ret 4; }
    # nothing reaches the far column
    if (dv_bmp[5 * 4 + 3] != 0) { ret 5; }
    ret 0;
}

test "info: composite outline needs room for every component" {
    build_dejavu();
    var f: Font = opened(?dv_buf[0], 512);
    # the first component fits exactly, and the second has nowhere to go
    val points: res[glyf.Outline, FontError] = glyph_outline(?f, 3, ?dv_pts[0], 4, ?dv_ends[0], 4);
    if (!sel points.err)             { ret 1; }
    if (!sel points.err.points_full) { ret 2; }
    val contours: res[glyf.Outline, FontError] = glyph_outline(?f, 3, ?dv_pts[0], 16, ?dv_ends[0], 1);
    if (!sel contours.err)               { ret 3; }
    if (!sel contours.err.contours_full) { ret 4; }
    ret 0;
}

test "info: self-referencing composite rejected" {
    build_dejavu();
    var f: Font = opened(?dv_buf[0], 512);
    # point glyph 3's first component at glyph 3
    w16(?dv_buf[0], DV_G3 + 12, 3);
    val r: res[glyf.Outline, FontError] = glyph_outline(?f, 3, ?dv_pts[0], 16, ?dv_ends[0], 4);
    if (!sel r.err)                 { ret 1; }
    if (!sel r.err.composite_depth) { ret 2; }
    ret 0;
}

test "info: mutually recursive composites rejected" {
    build_dejavu();
    var f: Font = opened(?dv_buf[0], 512);
    # glyph 5 already references glyph 3, so send glyph 3 back to glyph 5
    w16(?dv_buf[0], DV_G3 + 12, 5);
    if (!refused(glyph_outline(?f, 5, ?dv_pts[0], 16, ?dv_ends[0], 4))) { ret 1; }
    if (!refused(glyph_outline(?f, 3, ?dv_pts[0], 16, ?dv_ends[0], 4))) { ret 2; }
    ret 0;
}

test "info: point-matched component rejected" {
    build_dejavu();
    var f: Font = opened(?dv_buf[0], 512);
    # clear ARGS_ARE_XY_VALUES, leaving args that are point indices
    w16(?dv_buf[0], DV_G3 + 10, 0x1025);
    val r: res[glyf.Outline, FontError] = glyph_outline(?f, 3, ?dv_pts[0], 16, ?dv_ends[0], 4);
    if (!sel r.err)                         { ret 1; }
    if (!sel r.err.point_matched_component) { ret 2; }
    ret 0;
}

test "info: component out of range rejected" {
    build_dejavu();
    var f: Font = opened(?dv_buf[0], 512);
    w16(?dv_buf[0], DV_G3 + 12, 99);
    val r: res[glyf.Outline, FontError] = glyph_outline(?f, 3, ?dv_pts[0], 16, ?dv_ends[0], 4);
    if (!sel r.err)                     { ret 1; }
    if (!sel r.err.glyph_out_of_range)  { ret 2; }
    if (r.err.glyph_out_of_range != 99) { ret 3; }
    ret 0;
}

# test whether a kern lookup succeeded with exactly this correction
fun kerned(r: res[i16, FontError], value: i16) bool {
    if (sel r.ok) { ret r.ok == value; }
    ret false;
}

test "info: kern pairs through the facade" {
    build_dejavu();
    var f: Font = opened(?dv_buf[0], 512);
    if (!sel f.kern.ok)       { ret 1; }
    if (f.kern.ok.count != 4) { ret 2; }

    if (!kerned(glyph_kern_advance(?f, 16, 36), -45))   { ret 3; }
    if (!kerned(glyph_kern_advance(?f, 134, 90), -83))  { ret 4; }
    if (!kerned(glyph_kern_advance(?f, 134, 92), -139)) { ret 5; }
    if (!kerned(glyph_kern_advance(?f, 134, 109), -73)) { ret 6; }
    # an unkerned pair is not an error
    if (!kerned(glyph_kern_advance(?f, 79, 79), 0)) { ret 7; }
    ret 0;
}

test "info: a font without kerning reports none" {
    build_font();
    var f: Font                = opened(?font_buf[0], 320);
    val v: res[i16, FontError] = glyph_kern_advance(?f, 0, 1);
    if (!sel v.err)                    { ret 1; }
    if (!sel v.err.missing_table)      { ret 2; }
    if (!sel v.err.missing_table.kern) { ret 3; }
    ret 0;
}

test "info: outline maxima size composite buffers" {
    build_dejavu();
    var f: Font                             = opened(?dv_buf[0], 512);
    val r: res[opt[maxp.Maxima], FontError] = outline_maxima(?f);
    if (!sel r.ok)      { ret 1; }
    if (!sel r.ok.some) { ret 2; }
    val m: maxp.Maxima = r.ok.some;
    if (m.max_points != 4 || m.max_contours != 1) { ret 3; }
    # the composite maxima are what admit the nested glyph, and they do
    if (m.max_composite_points != 12 || m.max_composite_contours != 3) { ret 4; }
    val o: res[glyf.Outline, FontError] = glyph_outline(?f, 5, ?dv_pts[0], m.max_composite_points::usize, ?dv_ends[0], m.max_composite_contours::usize);
    if (!sel o.ok)             { ret 5; }
    if (o.ok.num_points != 12) { ret 6; }
    ret 0;
}
