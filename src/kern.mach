# the kerning table
#
# `kern` holds the per-pair spacing corrections a layout applies between two
# adjacent glyphs, the pre-GPOS mechanism and still the only kerning many
# truetype fonts carry. the table is a version-0 header naming a subtable count,
# followed by subtables that each declare their own format and axis in a coverage
# word. format 0 is the pair-array format: a list of (left, right, value) triples
# sorted by the packed (left, right) key, so a pair resolves by binary search.
#
# this module selects the first subtable that is format 0 and plainly horizontal,
# then resolves pairs from it. apple's `kern` variant opens with a 32-bit version
# and carries different subtable headers, so the version check rejects it rather
# than misreading its fields. every read is bounds-checked through font.read.

use font.error.FontError;
use font.read;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.result.res;
use std.types.size.usize;

# bytes in a subtable header: version, length, coverage
val SUBTABLE_HEADER: usize = 6;
# bytes between a format-0 subtable header and its pair array: nPairs plus the
# three binary-search hint fields, which are recomputed here rather than trusted
val FORMAT0_HEADER: usize = 8;
# bytes in one pair entry: left, right, value
val PAIR_SIZE: usize = 6;

# coverage low-byte flags
val COVERAGE_HORIZONTAL:   u16 = 0x01;
val COVERAGE_MINIMUM:      u16 = 0x02;
val COVERAGE_CROSS_STREAM: u16 = 0x04;

# the located pair array of a horizontal format-0 kerning subtable
# ---
# offset: byte offset of the first pair entry
# count:  number of pairs in the array
pub rec Pairs {
    offset: usize;
    count:  u16;
}

# locate the pair array of the font's horizontal format-0 kerning subtable
#
# walks the subtable chain and takes the first subtable that kerns horizontally in
# format 0 and states plain adjustments. a minimum-value or cross-stream subtable
# means something else and is skipped. the whole pair array is checked against the
# buffer here, so a later lookup searches it without re-validating its span.
# ---
# data: pointer to the first byte of the file
# len:  number of bytes addressable through data
# off:  byte offset of the kern table
# ret:  the pair array, or kern_version, kern_subtable_length, no_horizontal_kern or truncated
pub fun select_subtable(data: *u8, len: usize, off: usize) res[Pairs, FontError] {
    val version: res[u16, FontError] = read.read_u16(data, len, off);
    if (sel version.err) { ret res[Pairs, FontError].err{version.err}; }
    if (version.ok != 0) { ret res[Pairs, FontError].err{FontError.kern_version{version.ok}}; }

    val num_tables: res[u16, FontError] = read.read_u16(data, len, off + 2);
    if (sel num_tables.err) { ret res[Pairs, FontError].err{num_tables.err}; }

    var sub: usize = off + 4;
    var i:   u16   = 0;
    for (i < num_tables.ok) {
        val sub_len: res[u16, FontError] = read.read_u16(data, len, sub + 2);
        if (sel sub_len.err) { ret res[Pairs, FontError].err{sub_len.err}; }
        val coverage: res[u16, FontError] = read.read_u16(data, len, sub + 4);
        if (sel coverage.err) { ret res[Pairs, FontError].err{coverage.err}; }
        # a length that cannot even span its own header would not advance the walk.
        if (sub_len.ok::usize < SUBTABLE_HEADER) {
            ret res[Pairs, FontError].err{FontError.kern_subtable_length{sub_len.ok}};
        }

        # the coverage word carries the format in its high byte and the flags in its low.
        val format: u16  = coverage.ok >> 8;
        val flags:  u16  = coverage.ok & 0xFF;
        val plain:  bool = (flags & COVERAGE_MINIMUM) == 0 && (flags & COVERAGE_CROSS_STREAM) == 0;

        if (format == 0 && (flags & COVERAGE_HORIZONTAL) != 0 && plain) {
            val num_pairs: res[u16, FontError] = read.read_u16(data, len, sub + SUBTABLE_HEADER);
            if (sel num_pairs.err) { ret res[Pairs, FontError].err{num_pairs.err}; }
            val pairs: usize = sub + SUBTABLE_HEADER + FORMAT0_HEADER;
            if (pairs + num_pairs.ok::usize * PAIR_SIZE > len) {
                ret res[Pairs, FontError].err{FontError.truncated{pairs}};
            }
            ret res[Pairs, FontError].ok{Pairs{offset: pairs, count: num_pairs.ok}};
        }

        sub = sub + sub_len.ok::usize;
        i   = i + 1;
    }
    ret res[Pairs, FontError].err{FontError.no_horizontal_kern{}};
}

# read one pair entry's packed (left, right) key
fun pair_key(data: *u8, len: usize, entry: usize) res[u32, FontError] {
    val left: res[u16, FontError] = read.read_u16(data, len, entry);
    if (sel left.err) { ret res[u32, FontError].err{left.err}; }
    val right: res[u16, FontError] = read.read_u16(data, len, entry + 2);
    if (sel right.err) { ret res[u32, FontError].err{right.err}; }
    ret res[u32, FontError].ok{(left.ok::u32 << 16) | right.ok::u32};
}

# resolve the kerning adjustment between two adjacent glyphs
#
# the pair array is sorted by the packed (left, right) key, so the entry is found
# by binary search rather than by the subtable's own search hints, which some
# fonts write inconsistently. a pair the table does not list is unkerned and
# yields 0, the overwhelmingly common case and not an error.
# ---
# data:  pointer to the first byte of the file
# len:   number of bytes addressable through data
# pairs: the pair array, from select_subtable
# left:  glyph index of the left-hand glyph
# right: glyph index of the right-hand glyph
# ret:   the adjustment in font units (0 when the pair is unkerned), or truncated
pub fun lookup(data: *u8, len: usize, pairs: Pairs, left: u16, right: u16) res[i16, FontError] {
    val key: u32   = (left::u32 << 16) | right::u32;
    var lo:  usize = 0;
    var hi:  usize = pairs.count::usize;
    for (lo < hi) {
        val mid:   usize               = lo + (hi - lo) / 2;
        val entry: usize               = pairs.offset + mid * PAIR_SIZE;
        val k:     res[u32, FontError] = pair_key(data, len, entry);
        if (sel k.err) { ret res[i16, FontError].err{k.err}; }

        if (k.ok < key) { lo = mid + 1; }
        or (k.ok > key) { hi = mid; }
        or              { ret read.read_i16(data, len, entry + 4); }
    }
    ret res[i16, FontError].ok{0};
}

fun w16(buf: *u8, off: usize, v: u16) {
    buf[off]     = (v >> 8)::u8;
    buf[off + 1] = (v & 0xFF)::u8;
}

fun pair(buf: *u8, index: usize, left: u16, right: u16, value: u16) {
    val at: usize = 18 + index * 6;
    w16(buf, at, left);
    w16(buf, at + 2, right);
    w16(buf, at + 4, value);
}

# a version-0 table with one horizontal format-0 subtable of 4 pairs
var kern_buf: [64]u8;

fun build_kern() {
    val p: *u8 = ?kern_buf[0];
    w16(p, 0, 0); # version
    w16(p, 2, 1); # nTables
    w16(p, 4, 0); # subtable version
    w16(p, 6, 38); # subtable length: 6 header + 8 + 4 pairs * 6
    w16(p, 8, 0x0001); # coverage: format 0, horizontal
    w16(p, 10, 4); # nPairs
    # searchRange / entrySelector / rangeShift are written but never trusted
    w16(p, 12, 12);
    # pairs sorted by (left << 16) | right
    pair(p, 0, 1, 2, 0xFFB0); # -80
    pair(p, 1, 1, 9, 25);
    pair(p, 2, 3, 4, 0xFFCE); # -50
    pair(p, 3, 7, 1, 100);
}

# select the fixture's subtable, reporting failure as an empty array
fun selected() Pairs {
    val r: res[Pairs, FontError] = select_subtable(?kern_buf[0], 64, 0);
    if (sel r.ok) { ret r.ok; }
    ret Pairs{offset: 0, count: 0};
}

# test whether a lookup succeeded with exactly this adjustment
fun kerns(r: res[i16, FontError], value: i16) bool {
    if (sel r.ok) { ret r.ok == value; }
    ret false;
}

# test whether selection failed with no usable subtable
fun none_usable() bool {
    val r: res[Pairs, FontError] = select_subtable(?kern_buf[0], 64, 0);
    ret sel r.err && sel r.err.no_horizontal_kern;
}

test "kern: select horizontal format 0 subtable" {
    build_kern();
    val r: res[Pairs, FontError] = select_subtable(?kern_buf[0], 64, 0);
    if (!sel r.ok)         { ret 1; }
    if (r.ok.offset != 18) { ret 2; }
    if (r.ok.count != 4)   { ret 3; }
    ret 0;
}

test "kern: lookup finds every pair" {
    build_kern();
    val p: Pairs = selected();
    if (!kerns(lookup(?kern_buf[0], 64, p, 1, 2), -80)) { ret 1; }
    if (!kerns(lookup(?kern_buf[0], 64, p, 1, 9), 25))  { ret 2; }
    if (!kerns(lookup(?kern_buf[0], 64, p, 3, 4), -50)) { ret 3; }
    if (!kerns(lookup(?kern_buf[0], 64, p, 7, 1), 100)) { ret 4; }
    ret 0;
}

test "kern: unkerned pair yields zero" {
    build_kern();
    val p: Pairs = selected();
    if (p.count != 4) { ret 1; }
    # absent between listed keys, past the end, and before the start
    if (!kerns(lookup(?kern_buf[0], 64, p, 1, 5), 0)) { ret 2; }
    if (!kerns(lookup(?kern_buf[0], 64, p, 9, 9), 0)) { ret 3; }
    if (!kerns(lookup(?kern_buf[0], 64, p, 0, 0), 0)) { ret 4; }
    # a pair whose glyphs are listed only in the other order does not kern
    if (!kerns(lookup(?kern_buf[0], 64, p, 2, 1), 0)) { ret 5; }
    ret 0;
}

test "kern: vertical and cross-stream subtables skipped" {
    build_kern();
    w16(?kern_buf[0], 8, 0x0000); # format 0, vertical
    if (!none_usable()) { ret 1; }
    w16(?kern_buf[0], 8, 0x0005); # format 0, horizontal, cross-stream
    if (!none_usable()) { ret 2; }
    w16(?kern_buf[0], 8, 0x0003); # format 0, horizontal, minimum values
    if (!none_usable()) { ret 3; }
    ret 0;
}

test "kern: unsupported format skipped" {
    build_kern();
    w16(?kern_buf[0], 8, 0x0201); # format 2, horizontal
    if (!none_usable()) { ret 1; }
    ret 0;
}

test "kern: apple 32-bit version rejected" {
    build_kern();
    w16(?kern_buf[0], 0, 1); # 0x0001 opens apple's 0x00010000 version
    val r: res[Pairs, FontError] = select_subtable(?kern_buf[0], 64, 0);
    if (!sel r.err)              { ret 1; }
    if (!sel r.err.kern_version) { ret 2; }
    if (r.err.kern_version != 1) { ret 3; }
    ret 0;
}

test "kern: pair array past the buffer rejected" {
    build_kern();
    w16(?kern_buf[0], 10, 1000); # nPairs far beyond the buffer
    val r: res[Pairs, FontError] = select_subtable(?kern_buf[0], 64, 0);
    if (!sel r.err)            { ret 1; }
    if (!sel r.err.truncated)  { ret 2; }
    if (r.err.truncated != 18) { ret 3; }
    ret 0;
}

test "kern: subtable shorter than its header rejected" {
    build_kern();
    w16(?kern_buf[0], 2, 2); # nTables = 2
    w16(?kern_buf[0], 8, 0x0000); # first subtable is vertical, so the walk steps past it
    w16(?kern_buf[0], 6, 4); # ... by a length that cannot hold its header
    val r: res[Pairs, FontError] = select_subtable(?kern_buf[0], 64, 0);
    if (!sel r.err)                      { ret 1; }
    if (!sel r.err.kern_subtable_length) { ret 2; }
    if (r.err.kern_subtable_length != 4) { ret 3; }
    ret 0;
}

test "kern: second subtable reached past the first" {
    build_kern();
    w16(?kern_buf[0], 2, 2); # nTables = 2
    w16(?kern_buf[0], 8, 0x0000); # first subtable is vertical
    w16(?kern_buf[0], 6, 14); # ... and holds no pairs
    # a second horizontal format-0 subtable follows it at offset 18
    w16(?kern_buf[0], 18, 0); # version
    w16(?kern_buf[0], 20, 20); # length: 6 + 8 + 1 pair * 6
    w16(?kern_buf[0], 22, 0x0001); # coverage
    w16(?kern_buf[0], 24, 1); # nPairs
    w16(?kern_buf[0], 32, 5); # left
    w16(?kern_buf[0], 34, 6); # right
    w16(?kern_buf[0], 36, 0xFFEC); # -20
    val p: Pairs = selected();
    if (p.offset != 32 || p.count != 1)                 { ret 1; }
    if (!kerns(lookup(?kern_buf[0], 64, p, 5, 6), -20)) { ret 2; }
    ret 0;
}
