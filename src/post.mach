# the postscript table
#
# `post` carries the facts a document format describes a face by beyond its
# outlines: the slant of its italic, where an underline sits, and whether every
# glyph shares one advance. the glyph name list that follows is not read. all
# reads are bounds-checked through font.read.

use font.error.FontError;
use font.read;
use std.types.bool.bool;
use std.types.result.res;
use std.types.size.usize;

# the post table fields that describe a face
# ---
# italic_angle:        degrees counter-clockwise from vertical, as 16.16 fixed point
# underline_position:  the underline's top below the baseline, in font units
# underline_thickness: the underline's thickness, in font units
# is_fixed_pitch:      every glyph shares one advance width
pub rec Post {
    italic_angle:        i32;
    underline_position:  i16;
    underline_thickness: i16;
    is_fixed_pitch:      bool;
}

# parse the post table at off
# ---
# data: pointer to the first byte of the file
# len:  number of bytes addressable through data
# off:  byte offset of the post table
# ret:  the parsed fields, or truncated
pub fun parse_post(data: *u8, len: usize, off: usize) res[Post, FontError] {
    val angle: res[u32, FontError] = read.read_u32(data, len, off + 4);
    if (sel angle.err) { ret res[Post, FontError].err{angle.err}; }
    val position: res[i16, FontError] = read.read_i16(data, len, off + 8);
    if (sel position.err) { ret res[Post, FontError].err{position.err}; }
    val thickness: res[i16, FontError] = read.read_i16(data, len, off + 10);
    if (sel thickness.err) { ret res[Post, FontError].err{thickness.err}; }
    val fixed: res[u32, FontError] = read.read_u32(data, len, off + 12);
    if (sel fixed.err) { ret res[Post, FontError].err{fixed.err}; }
    ret res[Post, FontError].ok{Post{
        italic_angle:        angle.ok:~i32,
        underline_position:  position.ok,
        underline_thickness: thickness.ok,
        is_fixed_pitch:      fixed.ok != 0,
    }};
}

#[testing]
fun w16(buf: *u8, off: usize, v: u16) {
    buf[off]     = (v >> 8)::u8;
    buf[off + 1] = (v & 0xFF)::u8;
}

#[testing]
var post_buf: [32]u8;

test parse_post__fields {
    w16(?post_buf[0], 0, 3); # version 3.0
    w16(?post_buf[0], 4, 0xFFF4); # italic angle -12.0
    w16(?post_buf[0], 6, 0);
    w16(?post_buf[0], 8, 0xFF9C); # underline position -100
    w16(?post_buf[0], 10, 50); # underline thickness
    w16(?post_buf[0], 14, 1); # fixed pitch
    val r: res[Post, FontError] = parse_post(?post_buf[0], 32, 0);
    if (!sel r.ok)                        { ret 1; }
    if (r.ok.italic_angle != -12 * 65536) { ret 2; }
    if (r.ok.underline_position != -100)  { ret 3; }
    if (r.ok.underline_thickness != 50)   { ret 4; }
    if (!r.ok.is_fixed_pitch)             { ret 5; }
    val short: res[Post, FontError] = parse_post(?post_buf[0], 14, 0);
    if (!(sel short.err && sel short.err.truncated)) { ret 6; }
    ret 0;
}
