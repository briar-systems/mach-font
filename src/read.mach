# bounds-checked big-endian reads over an in-memory font file
#
# truetype and opentype store every scalar big-endian. font files are untrusted
# input, so each read validates that the requested span lies within the backing
# buffer before touching it, and a span that runs past the end reports
# `FontError.truncated` with the offset of the read.

use font.error.FontError;
use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.result.res;
use std.types.size.usize;

# read the byte at off
# ---
# data: pointer to the first byte of the file
# len:  number of bytes addressable through data
# off:  byte offset to read from
# ret:  the byte, or truncated when off is not below len
pub fun read_u8(data: *u8, len: usize, off: usize) res[u8, FontError] {
    if (off >= len) { ret res[u8, FontError].err{FontError.truncated{off}}; }
    ret res[u8, FontError].ok{data[off]};
}

# read a big-endian u16 at off
# ---
# data: pointer to the first byte of the file
# len:  number of bytes addressable through data
# off:  byte offset to read from
# ret:  the value, or truncated when [off, off+2) runs past len
pub fun read_u16(data: *u8, len: usize, off: usize) res[u16, FontError] {
    if (off + 2 > len) { ret res[u16, FontError].err{FontError.truncated{off}}; }
    val hi: u16 = data[off]::u16;
    val lo: u16 = data[off + 1]::u16;
    ret res[u16, FontError].ok{(hi << 8) | lo};
}

# read a big-endian i16 at off
# ---
# data: pointer to the first byte of the file
# len:  number of bytes addressable through data
# off:  byte offset to read from
# ret:  the value, or truncated when [off, off+2) runs past len
pub fun read_i16(data: *u8, len: usize, off: usize) res[i16, FontError] {
    val v: res[u16, FontError] = read_u16(data, len, off);
    if (sel v.err) { ret res[i16, FontError].err{v.err}; }
    ret res[i16, FontError].ok{v.ok::i16};
}

# read a big-endian u32 at off
# ---
# data: pointer to the first byte of the file
# len:  number of bytes addressable through data
# off:  byte offset to read from
# ret:  the value, or truncated when [off, off+4) runs past len
pub fun read_u32(data: *u8, len: usize, off: usize) res[u32, FontError] {
    if (off + 4 > len) { ret res[u32, FontError].err{FontError.truncated{off}}; }
    val b0: u32 = data[off]::u32;
    val b1: u32 = data[off + 1]::u32;
    val b2: u32 = data[off + 2]::u32;
    val b3: u32 = data[off + 3]::u32;
    ret res[u32, FontError].ok{(b0 << 24) | (b1 << 16) | (b2 << 8) | b3};
}

# read a big-endian F2Dot14 fixed-point value at off
#
# F2Dot14 is the sfnt fixed-point scalar carrying composite-glyph component
# transforms: a signed 16-bit value with 14 fractional bits, so 1.0 is stored as
# 0x4000 and the representable range is [-2, 2).
# ---
# data: pointer to the first byte of the file
# len:  number of bytes addressable through data
# off:  byte offset to read from
# ret:  the value, or truncated when [off, off+2) runs past len
pub fun read_f2dot14(data: *u8, len: usize, off: usize) res[f32, FontError] {
    val v: res[i16, FontError] = read_i16(data, len, off);
    if (sel v.err) { ret res[f32, FontError].err{v.err}; }
    ret res[f32, FontError].ok{v.ok::f32 / 16384.0};
}

# test whether the four bytes at off equal a table tag
#
# table directory entries name a table by a four-byte tag (`glyf`, `cmap`, ...),
# and this compares in place without materializing a string.
# ---
# data:       pointer to the first byte of the file
# len:        number of bytes addressable through data
# off:        byte offset of the candidate tag
# a, b, c, d: the four tag bytes to match
# ret:        whether the bytes match, or truncated when [off, off+4) runs past len
pub fun tag_eq(data: *u8, len: usize, off: usize, a: u8, b: u8, c: u8, d: u8) res[bool, FontError] {
    if (off + 4 > len) { ret res[bool, FontError].err{FontError.truncated{off}}; }
    val same: bool = data[off] == a && data[off + 1] == b && data[off + 2] == c && data[off + 3] == d;
    ret res[bool, FontError].ok{same};
}

var test_buf: [8]u8;

test "read: u8 in range" {
    test_buf[0] = 0x2A;
    val v: res[u8, FontError] = read_u8(?test_buf[0], 8, 0);
    if (!sel v.ok) { ret 1; }
    if (v.ok != 0x2A) { ret 2; }
    ret 0;
}

test "read: u8 out of range" {
    val v: res[u8, FontError] = read_u8(?test_buf[0], 4, 4);
    if (!sel v.err) { ret 1; }
    if (!sel v.err.truncated) { ret 2; }
    if (v.err.truncated != 4) { ret 3; }
    ret 0;
}

test "read: u16 big-endian" {
    test_buf[0] = 0x12;
    test_buf[1] = 0x34;
    val v: res[u16, FontError] = read_u16(?test_buf[0], 8, 0);
    if (!sel v.ok) { ret 1; }
    if (v.ok != 0x1234) { ret 2; }
    ret 0;
}

test "read: u16 truncated span" {
    val v: res[u16, FontError] = read_u16(?test_buf[0], 8, 7);
    if (!sel v.err) { ret 1; }
    if (!sel v.err.truncated) { ret 2; }
    if (v.err.truncated != 7) { ret 3; }
    ret 0;
}

test "read: i16 negative" {
    test_buf[0] = 0xFF;
    test_buf[1] = 0xFE;
    val v: res[i16, FontError] = read_i16(?test_buf[0], 8, 0);
    if (!sel v.ok) { ret 1; }
    if (v.ok != -2) { ret 2; }
    ret 0;
}

test "read: u32 big-endian" {
    test_buf[0] = 0xDE;
    test_buf[1] = 0xAD;
    test_buf[2] = 0xBE;
    test_buf[3] = 0xEF;
    val v: res[u32, FontError] = read_u32(?test_buf[0], 8, 0);
    if (!sel v.ok) { ret 1; }
    if (v.ok != 0xDEADBEEF) { ret 2; }
    ret 0;
}

test "read: f2dot14 unit and fraction" {
    test_buf[0] = 0x40;
    test_buf[1] = 0x00;
    val unit: res[f32, FontError] = read_f2dot14(?test_buf[0], 8, 0);
    if (!sel unit.ok) { ret 1; }
    if (unit.ok != 1.0) { ret 2; }
    # 0xE000 is -0.5: the F2Dot14 unit is 1/16384
    test_buf[0] = 0xE0;
    test_buf[1] = 0x00;
    val half: res[f32, FontError] = read_f2dot14(?test_buf[0], 8, 0);
    if (!sel half.ok) { ret 3; }
    if (half.ok != -0.5) { ret 4; }
    ret 0;
}

test "read: tag match" {
    test_buf[0] = 'g';
    test_buf[1] = 'l';
    test_buf[2] = 'y';
    test_buf[3] = 'f';
    val glyf: res[bool, FontError] = tag_eq(?test_buf[0], 8, 0, 'g', 'l', 'y', 'f');
    if (!sel glyf.ok) { ret 1; }
    if (!glyf.ok) { ret 2; }
    val cmap: res[bool, FontError] = tag_eq(?test_buf[0], 8, 0, 'c', 'm', 'a', 'p');
    if (!sel cmap.ok) { ret 3; }
    if (cmap.ok) { ret 4; }
    ret 0;
}

test "read: tag out of range" {
    val t: res[bool, FontError] = tag_eq(?test_buf[0], 2, 0, 'g', 'l', 'y', 'f');
    if (!sel t.err) { ret 1; }
    if (!sel t.err.truncated) { ret 2; }
    ret 0;
}
