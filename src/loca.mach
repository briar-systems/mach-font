# the glyph location table
#
# `loca` stores numGlyphs+1 offsets into the `glyf` table. glyph g occupies the
# byte range [loca[g], loca[g+1]) within glyf, and an empty range denotes a glyph
# with no outline (a space, say). two encodings exist: the short format stores
# each offset halved in a u16, the long format stores it directly in a u32. the
# active encoding is head's indexToLocFormat. all reads are bounds-checked through
# font.read.

use font.error.FontError;
use font.read;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.result.res;
use std.types.size.usize;

# a glyph's byte range within the glyf table
# ---
# start: offset of the glyph's first byte, relative to the start of glyf
# end:   offset just past its last byte, equal to start for an empty glyph
pub rec GlyphRange {
    start: u32;
    end:   u32;
}

# report whether a range holds no outline data
# ---
# r:   a glyph range
# ret: true when the glyph is empty
pub fun is_empty(r: *GlyphRange) bool {
    ret r.start == r.end;
}

# read glyph g's byte range within the glyf table
#
# both the g and g+1 offsets are read so the caller learns the glyph's start and
# end. the returned offsets are relative to the start of the glyf table.
# ---
# data:   pointer to the first byte of the file
# len:    number of bytes addressable through data
# off:    byte offset of the loca table
# format: indexToLocFormat from head (0 short, 1 long)
# glyph:  glyph index to locate
# ret:    the range, or loca_format, inverted_glyph or truncated
pub fun glyph_range(data: *u8, len: usize, off: usize, format: i16, glyph: u16) res[GlyphRange, FontError] {
    val g: usize = glyph::usize;
    var r: GlyphRange;

    if (format == 0) {
        val s: res[u16, FontError] = read.read_u16(data, len, off + g * 2);
        if (sel s.err) { ret res[GlyphRange, FontError].err{s.err}; }
        val e: res[u16, FontError] = read.read_u16(data, len, off + g * 2 + 2);
        if (sel e.err) { ret res[GlyphRange, FontError].err{e.err}; }
        # short offsets are stored halved.
        r = GlyphRange{start: s.ok::u32 * 2, end: e.ok::u32 * 2};
    }
    or (format == 1) {
        val s: res[u32, FontError] = read.read_u32(data, len, off + g * 4);
        if (sel s.err) { ret res[GlyphRange, FontError].err{s.err}; }
        val e: res[u32, FontError] = read.read_u32(data, len, off + g * 4 + 4);
        if (sel e.err) { ret res[GlyphRange, FontError].err{e.err}; }
        r = GlyphRange{start: s.ok, end: e.ok};
    }
    or {
        ret res[GlyphRange, FontError].err{FontError.loca_format{format}};
    }

    if (r.end < r.start) { ret res[GlyphRange, FontError].err{FontError.inverted_glyph{glyph}}; }
    ret res[GlyphRange, FontError].ok{r};
}

fun w16(buf: *u8, off: usize, v: u16) {
    buf[off]     = (v >> 8)::u8;
    buf[off + 1] = (v & 0xFF)::u8;
}

fun w32(buf: *u8, off: usize, v: u32) {
    buf[off]     = (v >> 24)::u8;
    buf[off + 1] = ((v >> 16) & 0xFF)::u8;
    buf[off + 2] = ((v >> 8) & 0xFF)::u8;
    buf[off + 3] = (v & 0xFF)::u8;
}

var loca_buf: [24]u8;

# test whether a lookup succeeded with exactly this range
fun is_range(r: res[GlyphRange, FontError], start: u32, end: u32) bool {
    if (sel r.ok) { ret r.ok.start == start && r.ok.end == end; }
    ret false;
}

test "loca: short format halved offsets" {
    # entries for 3 glyphs + terminator: 0, 6, 6, 20 (stored halved)
    w16(?loca_buf[0], 0, 0);
    w16(?loca_buf[0], 2, 3); # 6 / 2
    w16(?loca_buf[0], 4, 3); # 6 / 2 -> glyph 1 empty
    w16(?loca_buf[0], 6, 10); # 20 / 2
    if (!is_range(glyph_range(?loca_buf[0], 8, 0, 0, 0), 0, 6)) { ret 1; }
    val empty: res[GlyphRange, FontError] = glyph_range(?loca_buf[0], 8, 0, 0, 1);
    if (!sel empty.ok)                                           { ret 2; }
    if (!is_empty(?empty.ok) || empty.ok.start != 6)             { ret 3; }
    if (!is_range(glyph_range(?loca_buf[0], 8, 0, 0, 2), 6, 20)) { ret 4; }
    ret 0;
}

test "loca: long format direct offsets" {
    w32(?loca_buf[0], 0, 0);
    w32(?loca_buf[0], 4, 100);
    w32(?loca_buf[0], 8, 240);
    if (!is_range(glyph_range(?loca_buf[0], 12, 0, 1, 1), 100, 240)) { ret 1; }
    ret 0;
}

test "loca: truncated rejected" {
    val r: res[GlyphRange, FontError] = glyph_range(?loca_buf[0], 3, 0, 0, 0);
    if (!sel r.err)           { ret 1; }
    if (!sel r.err.truncated) { ret 2; }
    ret 0;
}

test "loca: unknown format rejected" {
    val r: res[GlyphRange, FontError] = glyph_range(?loca_buf[0], 24, 0, 2, 0);
    if (!sel r.err)             { ret 1; }
    if (!sel r.err.loca_format) { ret 2; }
    if (r.err.loca_format != 2) { ret 3; }
    ret 0;
}

test "loca: end before start rejected" {
    w16(?loca_buf[0], 0, 8);
    w16(?loca_buf[0], 2, 4);
    val r: res[GlyphRange, FontError] = glyph_range(?loca_buf[0], 8, 0, 0, 0);
    if (!sel r.err)                { ret 1; }
    if (!sel r.err.inverted_glyph) { ret 2; }
    ret 0;
}
